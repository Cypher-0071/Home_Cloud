PASSWORD=change-me
JWT_SECRET=generate-a-long-random-string

# File explorer jail. Defaults to the user home directory.
# BASE_DIR=/home/alice

# PORT=3000

# Cloudflare
# CF_DOMAIN=example.com
# TUNNEL_NAME=home-cloud
# CF_CONFIG=/home/alice/.cloudflared/config.yml

# Set false if you log in over plain HTTP on LAN (cookie will not be Secure).
# COOKIE_SECURE=true
