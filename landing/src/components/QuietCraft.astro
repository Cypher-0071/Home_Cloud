---
// landing/src/components/QuietCraft.astro
// Quiet Craft: Showcase of hardware realism, low-power silent operation,
// sovereign data ownership, and interactive 4K photo / ASCII telemetry matrix.
---

<section id="craft" class="craft-section">
  <div class="container craft-container">
    <div class="craft-grid">
      <!-- Left Column: Atmospheric Hardware Imagery & ASCII Matrix Switcher -->
      <div class="craft-visual-col reveal">
        <!-- Visual Mode Switcher Control -->
        <div class="craft-mode-bar">
          <span class="mode-label">Display Mode:</span>
          <div class="mode-toggle-group" role="tablist" aria-label="Hardware visualizer modes">
            <button
              type="button"
              id="mode-btn-photo"
              class="mode-btn is-active"
              role="tab"
              aria-selected="true"
              aria-controls="view-photo"
            >
              <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="3" width="12" height="10" rx="2" />
                <circle cx="8" cy="8" r="2.5" />
              </svg>
              <span>4K Photography</span>
            </button>
            <button
              type="button"
              id="mode-btn-ascii"
              class="mode-btn"
              role="tab"
              aria-selected="false"
              aria-controls="view-ascii"
            >
              <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
                <polyline points="2 5 6 9 2 13" />
                <line x1="8" y1="13" x2="14" y2="13" />
              </svg>
              <span>ASCII Telemetry HUD</span>
            </button>
          </div>
        </div>

        <div class="hardware-chassis-frame">
          <!-- View 1: 4K Photography -->
          <div id="view-photo" class="craft-view is-active" role="tabpanel" aria-labelledby="mode-btn-photo">
            <div class="hardware-frame">
              <img
                src="/server-hardware.jpg"
                alt="Compact matte black fanless home server humming quietly on a dark walnut desk with subtle warm amber indicator LED"
                class="hardware-img"
                loading="lazy"
                width="1280"
                height="720"
              />

              <!-- Ambient Glow & Reflection -->
              <div class="hardware-glow" aria-hidden="true"></div>

              <!-- Interactive Hotspot Badges -->
              <div class="hotspot-pin pin-heatsink" data-tooltip="Extruded 6063 Aluminum · Convection Cooled · 0 dB Noise">
                <span class="pin-pulse"></span>
                <span class="pin-dot"></span>
              </div>
              <div class="hotspot-pin pin-led" data-tooltip="Warm Phosphor Amber LED · 24/7 Quiet Status Light">
                <span class="pin-pulse"></span>
                <span class="pin-dot"></span>
              </div>
              <div class="hotspot-pin pin-cable" data-tooltip="Braided CAT6 · Outbound Encrypted QUIC Tunnel">
                <span class="pin-pulse"></span>
                <span class="pin-dot"></span>
              </div>

              </div>
            <div class="hardware-caption">
              <span>Actual compact fanless mini-PC footprint · 100% silent · Draws less power than an ambient LED bulb</span>
            </div>
          </div>

          <!-- View 2: ASCII Phosphor Telemetry HUD -->
          <div id="view-ascii" class="craft-view" role="tabpanel" aria-labelledby="mode-btn-ascii" hidden>
            <div class="ascii-terminal-frame">
              <div class="ascii-topbar">
                <div class="term-dots">
                  <span></span><span></span><span></span>
                </div>
                <span class="ascii-title">hardware-matrix — telemetry-stream</span>
                <span class="ascii-badge">PHOSPHOR-HUD</span>
              </div>
              <div class="ascii-body">
                <pre class="ascii-art">
  ┌───────────────────────────────────────────────────────────┐
  │ NODE: closet-node-01.lan        KERNEL: 6.8.0-45-generic  │
  │ LINK: TLS 1.3 (QUIC-MUX)        ARCH: x86_64 / N100       │
  └───────────────────────────────────────────────────────────┘
          |||||||||||||||||||||||||||||||||||||||||||||        
       ┌──|||||||||||||||||||||||||||||||||||||||||||||──┐     
       │  |||||||||||||||||||||||||||||||||||||||||||||  │     
       │  |||||||||||||||||||||||||||||||||||||||||||||  │     
    ┌──┴─────────────────────────────────────────────────┴──┐  
    │  [ETH0: 1000M/FD]                 [ <span class="ascii-led">●</span> ] 8.4W  37.5°C   │  
    │  [ZERO OPEN PORTS]               STATUS: STEADY ACTIVE│  
    └───────────────────────────────────────────────────────┘  
  <span class="ascii-hl">HARDWARE SPECIFICATIONS:</span>
  ├─ THERMALS:    <span class="ascii-metric">37.5°C</span> [PASSIVE RADIATOR · 0 RPM SILENT]
  ├─ WALL DRAW:   <span class="ascii-metric">8.4 W</span>  [~$0.85/MONTH 24/7 POWER DRAW]
  ├─ TUNNEL:      <span class="ascii-metric">ACTIVE</span> [OUTBOUND QUIC · 18ms EDGE LATENCY]
  ├─ SECURITY:    <span class="ascii-metric">LOCKED</span> [ZERO ROUTER PORTS FORWARDED]
  └─ STORAGE:     <span class="ascii-metric">2.0 TB</span> NVMe POOL (ext4) · SMART HEALTH 100%</pre>
              </div>
              <div class="ascii-footer">
                <span class="ascii-live-tag"><span class="pulse-dot"></span> LIVE HARDWARE TELEMETRY STREAM</span>
                <span class="ascii-foot-note">Passively cooled · Zero mechanical noise</span>
              </div>
            </div>
            <div class="hardware-caption">
              <span>Low-level systemd telemetry mapped to physical chassis sensors</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative & Hardware Craft Pillars -->
      <div class="craft-content-col reveal">
        <h2 class="craft-title">
          Hardware you own.<br />
          <span class="font-serif-italic">Privacy you actually keep.</span>
        </h2>

        <p class="craft-lede">
          Big tech sells convenience at the cost of monthly subscription rents, data harvesting,
          and artificial storage quotas. Home Cloud returns control to your desk.
          One quiet machine in the corner runs your digital life indefinitely.
        </p>

        <!-- 3 Hardware Craft Cards -->
        <div class="craft-pillars">
          <!-- Pillar 1 -->
          <div class="pillar-item">
            <div class="pillar-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v10M18.4 6.6a9 9 0 1 1-12.8 0"></path>
              </svg>
            </div>
            <div class="pillar-text">
              <h3 class="pillar-heading">Under 15W Idle Power Draw</h3>
              <p class="pillar-desc">
                Optimized for ultra-low overhead. Runs smoothly on Intel N100 mini PCs,
                Raspberry Pi 5, or ten-year-old ThinkPads with closed lids. Costs less than a cup of coffee a year in electricity.
              </p>
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="pillar-item">
            <div class="pillar-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div class="pillar-text">
              <h3 class="pillar-heading">Zero Router Port Forwarding</h3>
              <p class="pillar-desc">
                Bypasses Carrier-Grade NAT (CGNAT) and dynamic residential IPs via encrypted outbound
                Cloudflare Tunnels. Your home router firewall stays 100% closed to the public internet.
              </p>
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="pillar-item">
            <div class="pillar-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
              </svg>
            </div>
            <div class="pillar-text">
              <h3 class="pillar-heading">Direct Ext4 / ZFS Disk Storage</h3>
              <p class="pillar-desc">
                Your photos, backups, and databases live physically on your own SATA or NVMe drives.
                No arbitrary bandwidth caps, no sudden tier migrations, and no corporate terms of service.
              </p>
            </div>
          </div>
        </div>

        <!-- Value Metric Bar -->
        <div class="cost-comparison-card">
          <div class="comp-col vps">
            <span class="comp-label">Cloud VPS / S3 Storage</span>
            <span class="comp-price">$240 <small>/ year</small></span>
            <span class="comp-detail">Recurring rents & egress bandwidth fees</span>
          </div>
          <div class="comp-divider">vs</div>
          <div class="comp-col homecloud">
            <span class="comp-label">Home Cloud (Your Hardware)</span>
            <span class="comp-price free">$0 <small>/ year</small></span>
            <span class="comp-detail">One-time hardware ownership · Free forever</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .craft-section {
    position: relative;
    padding-block: clamp(4.5rem, 6vw, 8rem);
    background: transparent;
    border-top: 1px solid var(--hc-border-subtle);
    border-bottom: 1px solid var(--hc-border-subtle);
  }

  .craft-container {
    max-width: 1240px;
  }

  .craft-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* Left Column: Visual Hardware Frame */
  .craft-visual-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* Mode Switcher */
  .craft-mode-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 4px;
  }

  .mode-label {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mode-toggle-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-border-default);
    border-radius: 999px;
    padding: 3px;
  }

  .mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 550;
    color: var(--text-secondary);
    transition: all var(--dur-fast) var(--ease-out);
    cursor: pointer;
  }

  .mode-btn:hover {
    color: var(--text-primary);
  }

  .mode-btn.is-active {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--hc-border-strong);
    color: var(--hc-text-primary);
    box-shadow: none;
  }

  .hardware-chassis-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-border-default);
    box-shadow: none;
  }

  .craft-view {
    display: block;
    width: 100%;
  }

  .craft-view[hidden] {
    display: none !important;
  }

  .hardware-frame {
    position: relative;
    overflow: hidden;
  }

  .hardware-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 16 / 10;
    filter: brightness(0.98) contrast(1.05);
    transition: transform 0.6s var(--ease-out);
  }

  .hardware-chassis-frame:hover .hardware-img {
    transform: scale(1.02);
  }

  .hardware-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.6);
  }

  /* Hotspot Pins */
  .hotspot-pin {
    position: absolute;
    width: 16px;
    height: 16px;
    cursor: pointer;
    z-index: 10;
  }

  .pin-heatsink {
    top: 38%;
    left: 45%;
  }

  .pin-led {
    bottom: 32%;
    right: 38%;
  }

  .pin-cable {
    bottom: 25%;
    left: 28%;
  }

  .pin-dot {
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--hc-text-tertiary);
  }

  .pin-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--hc-text-tertiary);
    animation: pinPing 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes pinPing {
    0% { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  /* Overlay Telemetry Chips */
  .hardware-overlay-chips {
    position: absolute;
    inset: 0;
    pointer-events: none;
    padding: 16px;
  }

  .hw-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-border-default);
    box-shadow: none;
  }

  .hw-chip.top-left {
    top: 16px;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .hw-chip.bottom-left {
    bottom: 16px;
    left: 16px;
  }

  .hw-chip.bottom-right {
    bottom: 16px;
    right: 16px;
  }

  .hw-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hc-text-tertiary);
  }

  .hw-dot.green {
    background: var(--hc-text-tertiary);
  }

  .hw-dot.orange {
    background: var(--hc-text-tertiary);
  }

  .hw-dot.blue {
    background: var(--hc-text-tertiary);
  }

  .hw-chip-title {
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .hw-chip-val {
    color: var(--ok-night);
    font-weight: 600;
  }

  .hw-chip-content {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .hw-chip-label {
    font-size: 0.68rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .hw-chip-metric {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  /* ASCII Terminal Frame */
  .ascii-terminal-frame {
    background: var(--hc-canvas);
    padding: 16px 20px 20px;
    font-family: var(--font-mono);
  }

  .ascii-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 12px;
  }

  .ascii-title {
    font-size: 0.74rem;
    color: var(--text-tertiary);
  }

  .ascii-badge {
    font-size: 0.68rem;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-border-default);
    color: var(--hc-text-tertiary);
  }

  .ascii-body {
    overflow-x: auto;
    padding-block: 8px;
  }

  .ascii-art {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.35;
    color: var(--hc-text-secondary);
    white-space: pre;
    text-shadow: none;
  }

  .ascii-led {
    color: var(--hc-text-primary);
    text-shadow: none;
  }

  .ascii-hl {
    color: var(--hc-text-primary);
    font-weight: 600;
  }

  .ascii-metric {
    color: var(--ok);
    font-weight: 600;
  }

  .ascii-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 12px;
    font-size: 0.72rem;
    color: var(--text-tertiary);
  }

  .ascii-live-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ok-night);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
  }

  .hardware-caption {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    text-align: center;
    margin-top: 4px;
  }

  /* Right Column: Narrative */
  .craft-content-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-border-default);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--hc-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    width: fit-content;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hc-text-tertiary);
  }

  .craft-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.85rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .craft-lede {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .craft-pillars {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-block: var(--space-2);
  }

  .pillar-item {
    display: flex;
    gap: 16px;
    padding: 16px;
    border-radius: 12px;
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-border-subtle);
    transition: all var(--dur-fast) var(--ease-out);
  }

  .pillar-item:hover {
    background: var(--hc-surface-2);
    border-color: var(--hc-border-default);
    transform: translateX(4px);
  }

  .pillar-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--hc-surface-2);
    border: 1px solid var(--hc-border-default);
    color: var(--hc-text-secondary);
    flex-shrink: 0;
  }

  .pillar-text {
    flex: 1;
    min-width: 0;
  }

  .pillar-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }

  .pillar-heading {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .pillar-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Cost comparison */
  .cost-comparison-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-radius: 12px;
    background: var(--hc-canvas);
    border: 1px solid var(--hc-border-default);
    gap: 16px;
  }

  .comp-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .comp-label {
    font-size: 0.74rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 500;
  }

  .comp-price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: #ef4444;
  }

  .comp-price small {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .comp-price.free {
    color: var(--ok);
  }

  .comp-detail {
    font-size: 0.74rem;
    color: var(--text-tertiary);
  }

  .comp-divider {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    padding: 6px;
  }

  @media (max-width: 900px) {
    .craft-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cost-comparison-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .comp-divider {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hardware-overlay-chips {
      padding: 10px;
    }
    .hw-chip {
      padding: 4px 8px;
    }
    .hw-chip.top-left {
      top: 10px;
      left: 10px;
      font-size: 0.65rem;
    }
    .hw-chip.bottom-left {
      bottom: 10px;
      left: 10px;
    }
    .hw-chip.bottom-right {
      bottom: 10px;
      right: 10px;
    }
    .hw-chip-label {
      font-size: 0.62rem;
    }
    .hw-chip-metric {
      font-size: 0.72rem;
    }
    .ascii-art {
      font-size: 0.6rem;
    }
  }
</style>

<script>
  // View mode switcher: Photography vs ASCII Telemetry HUD
  const photoBtn = document.getElementById('mode-btn-photo');
  const asciiBtn = document.getElementById('mode-btn-ascii');
  const photoView = document.getElementById('view-photo');
  const asciiView = document.getElementById('view-ascii');

  if (photoBtn && asciiBtn && photoView && asciiView) {
    photoBtn.addEventListener('click', () => {
      photoBtn.classList.add('is-active');
      photoBtn.setAttribute('aria-selected', 'true');
      asciiBtn.classList.remove('is-active');
      asciiBtn.setAttribute('aria-selected', 'false');

      photoView.removeAttribute('hidden');
      photoView.classList.add('is-active');
      asciiView.setAttribute('hidden', '');
      asciiView.classList.remove('is-active');
    });

    asciiBtn.addEventListener('click', () => {
      asciiBtn.classList.add('is-active');
      asciiBtn.setAttribute('aria-selected', 'true');
      photoBtn.classList.remove('is-active');
      photoBtn.setAttribute('aria-selected', 'false');

      asciiView.removeAttribute('hidden');
      asciiView.classList.add('is-active');
      photoView.setAttribute('hidden', '');
      photoView.classList.remove('is-active');
    });
  }
</script>
