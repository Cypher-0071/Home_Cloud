---
// Footer — Home Cloud Landing Page
// Direction: Paper & Signal — Night surface, final CTA, edge-to-edge serif wordmark, status LED
const INSTALL_COMMAND =
  'curl -fsSL https://raw.githubusercontent.com/Cypher-0071/Home_Cloud/main/setup.sh -o setup.sh && chmod +x setup.sh && ./setup.sh';
const GITHUB_URL = 'https://github.com/Cypher-0071/Home_Cloud';
const SETUP_SH_URL =
  'https://github.com/Cypher-0071/Home_Cloud/blob/main/setup.sh';
const DOCS_URL = 'https://github.com/Cypher-0071/Home_Cloud/tree/main/docs';
---

<footer id="footer" class="footer-night">
  <div class="container footer-container">
    <!-- Top CTA Block -->
    <div class="footer-cta reveal">
      <div class="footer-eyebrow-row">
        <span class="eyebrow eyebrow-night">§ 06 — Terminal Cockpit</span>
        <span class="footer-spec-id">DOC. ID: HC-END-06</span>
      </div>

      <h2 class="display display-night">
        Your closet is <em>a datacenter now.</em>
      </h2>

      <p class="lede-night">
        Plug in the ethernet cable. Close the laptop lid. Take complete control of your host from any browser in the world — without cloud bills or open router ports.
      </p>

      <!-- Action Pill & GitHub Button -->
      <div class="cta-actions">
        <!-- Install Command Pill -->
        <div class="install-pill" id="footer-install-pill">
          <span class="pill-prompt" aria-hidden="true">$</span>
          <code class="pill-code" id="footer-cmd-text">{INSTALL_COMMAND}</code>
          <button
            type="button"
            class="pill-copy-btn"
            id="footer-copy-btn"
            aria-label="Copy install command to clipboard"
          >
            <svg class="icon-copy" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="5" width="9" height="9" rx="1.5" />
              <path d="M3 11V3a1.5 1.5 0 0 1 1.5-1.5H11" />
            </svg>
            <svg class="icon-check" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8.5l3.5 3.5 6.5-7.5" />
            </svg>
            <span class="copy-text">Copy</span>
          </button>
        </div>

        <!-- GitHub Ghost Button -->
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-night-ghost"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>Star on GitHub</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Giant Edge-to-Edge Serif Wordmark -->
  <div class="wordmark-wrap" aria-hidden="true">
    <div class="wordmark-inner">
      <span class="wordmark-text">Home Cloud<span class="wordmark-dot">.</span></span>
    </div>
  </div>

  <!-- Bottom Nav & Technical Metas -->
  <div class="footer-bottom-bar">
    <div class="container bottom-container">
      <!-- Mono Navigation Links -->
      <nav class="footer-links" aria-label="Footer links">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="foot-link">GitHub</a>
        <span class="foot-sep">/</span>
        <a href={SETUP_SH_URL} target="_blank" rel="noopener noreferrer" class="foot-link">setup.sh</a>
        <span class="foot-sep">/</span>
        <a href={DOCS_URL} target="_blank" rel="noopener noreferrer" class="foot-link">Docs</a>
        <span class="foot-sep">/</span>
        <a href="#features" class="foot-link">Roadmap</a>
      </nav>

      <!-- Center Creed -->
      <div class="footer-creed">
        <span class="creed-text">Built for one box. Open source.</span>
      </div>

      <!-- Live Status LED with wit -->
      <div class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-label">All systems: your problem.</span>
      </div>
    </div>
  </div>

  <!-- System specs micro-strip -->
  <div class="footer-sub-strip">
    <div class="container strip-container">
      <span class="micro-spec">DAEMON PORT: 3000</span>
      <span class="micro-spec">TUNNEL: CLOUDFLARE</span>
      <span class="micro-spec">SYSTEMD: ACTIVE</span>
      <span class="micro-spec">NO TELEMETRY · OPEN SOURCE</span>
    </div>
  </div>
</footer>

<style>
  .footer-night {
    background: var(--night);
    color: var(--night-text);
    border-top: 1px solid var(--night-rule);
    padding-top: var(--section-pad);
    position: relative;
    overflow: hidden;
  }

  .footer-container {
    position: relative;
    z-index: 2;
  }

  .footer-cta {
    max-width: 860px;
    margin-bottom: clamp(3rem, 5vw, 5.5rem);
  }

  .footer-eyebrow-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .eyebrow-night {
    color: var(--night-text-2);
  }
  .eyebrow-night::before {
    background: var(--signal);
  }

  .footer-spec-id {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--night-text-2);
    letter-spacing: 0.08em;
  }

  .display-night {
    font-size: var(--step-3);
    color: var(--night-text);
    line-height: 1.05;
    margin-bottom: var(--space-4);
  }
  .display-night em {
    font-style: italic;
    color: var(--signal);
  }

  .lede-night {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--night-text-2);
    max-width: 62ch;
    margin-bottom: var(--space-6);
  }

  /* Actions */
  .cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Install Pill */
  .install-pill {
    display: inline-flex;
    align-items: center;
    background: var(--night-2);
    border: 1px solid var(--night-rule);
    border-radius: 999px;
    padding: 6px 6px 6px 16px;
    gap: 8px;
    max-width: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .install-pill:hover {
    border-color: rgba(241, 237, 228, 0.25);
  }

  .pill-prompt {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--signal);
    user-select: none;
    flex-shrink: 0;
  }

  .pill-code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--night-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: min(520px, 45vw);
  }

  @media (max-width: 680px) {
    .pill-code {
      max-width: 190px;
    }
  }

  .pill-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--night-3);
    border: 1px solid var(--night-rule);
    color: var(--night-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .pill-copy-btn:hover {
    background: var(--signal);
    color: var(--night);
    border-color: var(--signal);
  }

  .pill-copy-btn .icon-check {
    display: none;
  }
  .pill-copy-btn.is-copied {
    background: var(--ok);
    color: var(--paper);
    border-color: var(--ok);
  }
  .pill-copy-btn.is-copied .icon-copy {
    display: none;
  }
  .pill-copy-btn.is-copied .icon-check {
    display: block;
  }

  /* GitHub Night Ghost Button */
  .btn-night-ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 44px;
    padding-inline: var(--space-5);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--night-text);
    background: var(--night-2);
    border: 1px solid var(--night-rule);
    transition: all var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .btn-night-ghost:hover {
    border-color: rgba(241, 237, 228, 0.4);
    background: var(--night-3);
    color: #fff;
    transform: translateY(-1px);
  }

  /* Giant Edge-to-Edge Serif Wordmark */
  .wordmark-wrap {
    width: 100%;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
    display: flex;
    justify-content: center;
    border-bottom: 1px solid var(--night-rule);
    padding-bottom: clamp(1rem, 2.5vw, 2.5rem);
    margin-top: var(--space-5);
  }

  .wordmark-inner {
    width: 100%;
    text-align: center;
    line-height: 0.8;
  }

  .wordmark-text {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.8rem, 15.6vw, 15.5rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: rgba(236, 232, 222, 0.08);
    white-space: nowrap;
    display: inline-block;
  }

  .wordmark-dot {
    color: var(--signal);
    opacity: 0.9;
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    padding-block: var(--space-5);
    border-bottom: 1px solid rgba(241, 237, 228, 0.06);
  }

  .bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 780px) {
    .bottom-container {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .foot-link {
    color: var(--night-text-2);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-link:hover {
    color: var(--night-text);
  }

  .foot-sep {
    color: rgba(241, 237, 228, 0.2);
    user-select: none;
  }

  .footer-creed {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--night-text-2);
    letter-spacing: 0.04em;
  }

  /* Status LED */
  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--night-2);
    border: 1px solid var(--night-rule);
    padding: 4px 10px;
    border-radius: 999px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok-night);
    box-shadow: 0 0 8px rgba(91, 214, 138, 0.5);
    animation: statusPulse 2.8s infinite ease-in-out;
  }

  @keyframes statusPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none !important;
    }
  }

  .status-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--night-text);
    letter-spacing: 0.02em;
  }

  /* Sub Strip */
  .footer-sub-strip {
    padding-block: var(--space-3);
    background: #080907;
  }

  .strip-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .micro-spec {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: rgba(163, 158, 146, 0.6);
  }
</style>

<script>
  function initFooterActions() {
    const copyBtn = document.getElementById('footer-copy-btn');
    const cmdText = document.getElementById('footer-cmd-text');

    if (!copyBtn || !cmdText) return;

    copyBtn.addEventListener('click', async () => {
      const textToCopy = cmdText.textContent?.trim() || '';
      try {
        await navigator.clipboard.writeText(textToCopy);
        copyBtn.classList.add('is-copied');
        const label = copyBtn.querySelector('.copy-text');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          if (label) label.textContent = 'Copy';
        }, 1600);
      } catch (err) {
        console.error('Failed to copy command', err);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterActions);
  } else {
    initFooterActions();
  }
</script>
