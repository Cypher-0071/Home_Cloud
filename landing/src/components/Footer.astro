---
// landing/src/components/Footer.astro
// Editorial closing composition: brand statement with corner brackets,
// two compact link groups, and a quiet bottom row with back-to-top.
// No sitemap grid, no install panel, no unverified claims.
---

<footer class="footer-root">
  <div class="container footer-grid">
    <!-- Brand statement -->
    <div class="footer-brand-block">
      <div class="brand-corners" aria-hidden="true"></div>
      <a href="#hero" class="footer-brand">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="7" rx="2"></rect>
          <rect x="2" y="13" width="20" height="7" rx="2"></rect>
          <circle cx="6" cy="7.5" r="1" fill="currentColor"></circle>
          <circle cx="6" cy="16.5" r="1" fill="currentColor"></circle>
        </svg>
        <span class="footer-brand-label">HOME CLOUD / OPEN SOURCE · SELF-HOSTED</span>
      </a>
      <p class="footer-closing">
        Your hardware.<br />Your rules.
      </p>
      <p class="footer-support">
        A private cloud that runs on your machine, under your control.
      </p>
    </div>

    <!-- Navigation -->
    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-group">
        <span class="footer-group-title">EXPLORE</span>
        <a href="#features" class="f-link">Features</a>
        <a href="#how-it-works" class="f-link">How It Works</a>
        <a href="#setup" class="f-link">Setup Guide</a>
      </div>
      <div class="footer-group">
        <span class="footer-group-title">PROJECT</span>
        <a href="https://github.com/Cypher-0071/Home_Cloud" target="_blank" rel="noopener noreferrer" class="f-link">GitHub Repository</a>
        <a href="https://github.com/Cypher-0071/Home_Cloud/issues" target="_blank" rel="noopener noreferrer" class="f-link">Issue Tracker</a>
        <a href="https://github.com/Cypher-0071/Home_Cloud/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="f-link">MIT License</a>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <span class="footer-copy">© 2026 Home Cloud. Released under the MIT License.</span>
    <span class="footer-desc">Open source · Self-hosted · No cloud account required.</span>
    <button type="button" class="to-top" id="footer-to-top" aria-label="Back to top">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 13V3M4 7l4-4 4 4"></path>
      </svg>
    </button>
  </div>
</footer>

<style>
  .footer-root {
    position: relative;
    background: var(--hc-canvas);
    border-top: 1px solid var(--hc-border-subtle);
    padding-top: clamp(4rem, 7vw, 7rem);
    padding-bottom: clamp(2rem, 3vw, 3rem);
    color: var(--text-secondary);
  }

  /* Asymmetric: statement dominant, navigation secondary */
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .footer-brand-block {
    position: relative;
    padding: clamp(24px, 3vw, 40px) clamp(20px, 3vw, 36px);
  }

  /* Restrained corner brackets, top-left + bottom-right */
  .brand-corners::before,
  .brand-corners::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    pointer-events: none;
  }

  .brand-corners::before {
    top: 0;
    left: 0;
    border-top: 1px solid var(--hc-border-strong);
    border-left: 1px solid var(--hc-border-strong);
  }

  .brand-corners::after {
    bottom: 0;
    right: 0;
    border-bottom: 1px solid var(--hc-border-strong);
    border-right: 1px solid var(--hc-border-strong);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--hc-space-5);
    color: var(--text-primary);
  }

  .footer-brand svg {
    color: var(--signal-text);
    flex-shrink: 0;
  }

  .footer-brand-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }

  .footer-closing {
    margin: 0 0 var(--hc-space-4);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 3rem + 2.5vw, 4rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .footer-support {
    margin: 0;
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Compact link groups */
  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--hc-space-6);
    padding-top: 6px;
  }

  .footer-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-group-title {
    margin-bottom: 2px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .f-link {
    font-size: 0.88rem;
    color: var(--text-secondary);
    transition: color var(--dur-fast);
    width: fit-content;
  }

  .f-link:hover {
    color: #ffffff;
  }

  /* Bottom row */
  .footer-bottom {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: var(--hc-space-5);
    border-top: 1px solid var(--hc-border-subtle);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-desc {
    margin-left: auto;
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--hc-border-default);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .to-top:hover {
    border-color: var(--hc-border-strong);
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--hc-space-7);
    }
    .footer-nav {
      grid-template-columns: 1fr 1fr;
    }
    .footer-bottom {
      flex-wrap: wrap;
    }
    .footer-desc {
      margin-left: 0;
      width: 100%;
    }
  }

  @media (max-width: 540px) {
    .footer-nav {
      grid-template-columns: 1fr;
      gap: var(--hc-space-5);
    }
  }
</style>

<script>
  // Circular back-to-top control (no prior implementation existed).
  const toTop = document.getElementById('footer-to-top');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (toTop) {
    toTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
  }
</script>
