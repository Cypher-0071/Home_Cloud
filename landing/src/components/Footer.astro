---
// landing/src/components/Footer.astro
// Minimal Footer: Clean links, quiet status indicator, refined typography, zero datasheets.
---

<footer class="footer-root">
  <div class="container footer-container">
    <!-- Top Footer Bar: Brand + Quiet Status -->
    <div class="footer-top">
      <div class="footer-brand-wrap">
        <a href="#hero" class="footer-brand">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="7" rx="2"></rect>
            <rect x="2" y="13" width="20" height="7" rx="2"></rect>
            <circle cx="6" cy="7.5" r="1" fill="currentColor"></circle>
            <circle cx="6" cy="16.5" r="1" fill="currentColor"></circle>
          </svg>
          <span class="footer-brand-name">Home Cloud</span>
        </a>
        <p class="footer-motto">
          Sovereign personal cloud control plane. Open source, self-hosted, private.
        </p>
      </div>
    </div>

    <!-- Divider -->
    <div class="footer-rule"></div>

    <!-- Navigation & Links -->
    <div class="footer-links-grid">
      <div class="link-col">
        <span class="link-col-title">Product</span>
        <a href="#craft" class="f-link">Hardware Craft</a>
        <a href="#features" class="f-link">Subsystems</a>
        <a href="#setup" class="f-link">Quickstart Guide</a>
      </div>

      <div class="link-col">
        <span class="link-col-title">Subsystems</span>
        <a href="#features" class="f-link">Host Terminal (PTY)</a>
        <a href="#features" class="f-link">Docker Container Deck</a>
        <a href="#features" class="f-link">Direct Ext4 Filesystem</a>
        <a href="#features" class="f-link">Cloudflare Zero-Trust Tunnel</a>
      </div>

      <div class="link-col">
        <span class="link-col-title">Open Source</span>
        <a href="https://github.com/Cypher-0071/Home_Cloud" target="_blank" rel="noopener noreferrer" class="f-link">GitHub Repository</a>
        <a href="https://github.com/Cypher-0071/Home_Cloud/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="f-link">MIT License</a>
        <a href="https://github.com/Cypher-0071/Home_Cloud/issues" target="_blank" rel="noopener noreferrer" class="f-link">Issue Tracker</a>
        <a href="https://github.com/Cypher-0071/Home_Cloud/releases" target="_blank" rel="noopener noreferrer" class="f-link">Release Notes</a>
      </div>

      <div class="link-col">
        <span class="link-col-title">Quick Install</span>
        <div class="footer-mini-cmd">
          <code>curl -fsSL ... | bash</code>
          <a href="#setup" class="mini-cmd-link">View Command →</a>
        </div>
        <span class="footer-req-note">Requires Linux x86_64 or arm64</span>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-copy">
        © 2026 Home Cloud. Released under the MIT License.
      </div>
      <div class="footer-legal">
        <span>Runs locally on your hardware. Zero telemetry phoned home.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-root {
    position: relative;
    background: var(--hc-canvas);
    border-top: 1px solid var(--hc-border-subtle);
    padding-top: clamp(3rem, 5vw, 5rem);
    padding-bottom: clamp(2rem, 3vw, 3.5rem);
    color: var(--text-secondary);
  }

  .footer-container {
    max-width: 1200px;
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .footer-brand-wrap {
    max-width: 420px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .footer-brand svg {
    color: var(--hc-text-secondary);
  }

  .footer-brand-name {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer-motto {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-tertiary);
  }


  .footer-rule {
    height: 1px;
    background: var(--hc-border-subtle);
    margin-bottom: var(--space-6);
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .link-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .link-col-title {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .f-link {
    font-size: 0.86rem;
    color: var(--text-secondary);
    transition: color var(--dur-fast);
  }

  .f-link:hover {
    color: #ffffff;
  }

  .footer-mini-cmd {
    background: var(--hc-surface-1);
    border: 1px solid var(--hc-border-default);
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-mini-cmd code {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--hc-text-primary);
  }

  .mini-cmd-link {
    font-size: 0.75rem;
    color: var(--signal-text);
    font-weight: 500;
  }

  .footer-req-note {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 820px) {
    .footer-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .footer-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
