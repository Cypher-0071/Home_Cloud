---
// §04 Install — Home Cloud Landing Page
// Direction: Paper & Signal — Engineering spec sheet with night terminal card
const INSTALL_COMMAND =
  'curl -fsSL https://raw.githubusercontent.com/Cypher-0071/Home_Cloud/main/setup.sh -o setup.sh && chmod +x setup.sh && ./setup.sh';
const SETUP_SH_URL =
  'https://github.com/Cypher-0071/Home_Cloud/blob/main/setup.sh';
---

<section id="install" class="section install-section">
  <div class="container">
    <!-- Header -->
    <header class="install-header reveal">
      <div class="header-eyebrow-row">
        <span class="eyebrow">§ 04 — Install</span>
        <span class="spec-id">DOC. ID: HC-INST-04</span>
      </div>
      <h2 class="display install-title">One command. <em>Go make tea.</em></h2>
      <p class="lede install-lede">
        The installer waits for package locks, configures dependencies, writes your systemd unit,
        and provisions a zero-port Cloudflare Tunnel in approximately four minutes.
      </p>
    </header>

    <!-- Main 2-column grid -->
    <div class="install-grid">
      <!-- Left Column: Specs, Prerequisites & Audit -->
      <div class="install-left reveal" style="--reveal-delay: 80ms">
        <div class="spec-panel">
          <div class="panel-tag-bar">
            <span class="mono-tag">PREREQUISITES</span>
            <span class="mono-subtag">HOST SPECIFICATION</span>
          </div>

          <ul class="req-list">
            <li class="req-item">
              <span class="req-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8.5l3.5 3.5 6.5-7.5" />
                </svg>
              </span>
              <div class="req-content">
                <div class="req-title">Linux Host</div>
                <div class="req-desc">
                  Ubuntu Server or Debian recommended. Tested on <code class="mono-inline">x86_64</code> and <code class="mono-inline">arm64</code> (including Raspberry Pi 4/5).
                </div>
              </div>
            </li>

            <li class="req-item">
              <span class="req-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8.5l3.5 3.5 6.5-7.5" />
                </svg>
              </span>
              <div class="req-content">
                <div class="req-title">Sudo Privileges</div>
                <div class="req-desc">
                  Root or user with <code class="mono-inline">sudo</code> rights to register systemd units and manage the Docker socket group.
                </div>
              </div>
            </li>

            <li class="req-item">
              <span class="req-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8.5l3.5 3.5 6.5-7.5" />
                </svg>
              </span>
              <div class="req-content">
                <div class="req-title">Domain on Cloudflare <span class="req-optional">(optional)</span></div>
                <div class="req-desc">
                  Required for zero-port remote HTTPS access (<code class="mono-inline">dash.you.dev</code>). Skip it to run in LAN-only mode (<code class="mono-inline">:3000</code>).
                </div>
              </div>
            </li>
          </ul>

          <div class="audit-callout">
            <div class="audit-header">
              <span class="audit-bullet" aria-hidden="true"></span>
              <span class="audit-tag">AUDIT FIRST</span>
            </div>
            <p class="audit-text">
              Prefer to read before you pipe? Good. The script is ~700 lines of cleanly structured, commented bash.
            </p>
            <a
              href={SETUP_SH_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="audit-link"
            >
              <span>Inspect setup.sh on GitHub</span>
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 11L11 3M11 3H5M11 3V9" />
              </svg>
            </a>
          </div>

          <div class="hardware-strip">
            <div class="hw-col">
              <span class="hw-lbl">RUNTIME</span>
              <span class="hw-val">NODE 24</span>
            </div>
            <div class="hw-col">
              <span class="hw-lbl">ARCH</span>
              <span class="hw-val">x86_64 / ARM64</span>
            </div>
            <div class="hw-col">
              <span class="hw-lbl">DAEMONS</span>
              <span class="hw-val">1 SYSTEMD</span>
            </div>
            <div class="hw-col">
              <span class="hw-lbl">ROUTER PORTS</span>
              <span class="hw-val">0 INBOUND</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Night Terminal Card with Replay -->
      <div class="install-right reveal" style="--reveal-delay: 140ms">
        <div class="terminal-card" id="install-terminal">
          <!-- Terminal Titlebar -->
          <div class="terminal-bar">
            <div class="terminal-title-group">
              <span class="terminal-indicator" aria-hidden="true"></span>
              <span class="terminal-title">bash — setup.sh</span>
            </div>
            <div class="terminal-actions">
              <span class="terminal-status" id="term-status-badge">READY</span>
              <button
                type="button"
                class="term-action-btn"
                id="term-replay-btn"
                aria-label="Replay installer log output"
                title="Replay installer log"
              >
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.5 8a5.5 5.5 0 1 1 1.6 3.9L1.5 14.5" />
                  <path d="M1.5 9.5V14.5H6.5" />
                </svg>
                <span>Replay</span>
              </button>
            </div>
          </div>

          <!-- Command prompt strip -->
          <div class="cmd-strip">
            <div class="cmd-inner">
              <span class="cmd-prompt" aria-hidden="true">$</span>
              <code class="cmd-code" id="install-cmd-text">{INSTALL_COMMAND}</code>
            </div>
            <button
              type="button"
              class="cmd-copy-btn"
              id="term-copy-btn"
              aria-label="Copy install command to clipboard"
            >
              <svg class="icon-copy" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5" y="5" width="9" height="9" rx="1.5" />
                <path d="M3 11V3a1.5 1.5 0 0 1 1.5-1.5H11" />
              </svg>
              <svg class="icon-check" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8.5l3.5 3.5 6.5-7.5" />
              </svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>

          <!-- Log Viewport -->
          <div class="terminal-console" id="term-console" role="region" aria-label="Terminal log output">
            <div class="log-stream" id="term-log-stream">
              <!-- Replay lines injected via JS -->
            </div>
            <div class="term-cursor-row" id="term-cursor-row">
              <span class="term-caret" aria-hidden="true"></span>
            </div>
          </div>

          <!-- Terminal Bottom Spec Footer -->
          <div class="terminal-footer">
            <span class="tf-item">DISTRO: UBUNTU / DEBIAN</span>
            <span class="tf-item">INIT: SYSTEMD</span>
            <span class="tf-item">TUNNEL: QUIC / WIREGUARD</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Manual Install Details Section -->
    <div class="manual-wrap reveal" style="--reveal-delay: 180ms">
      <details class="manual-details">
        <summary class="manual-summary">
          <div class="summary-left">
            <span class="manual-badge">MANUAL INSTALL</span>
            <span class="summary-title">Prefer step-by-step control? Build directly from source</span>
          </div>
          <div class="summary-right">
            <span class="summary-hint">README steps</span>
            <span class="summary-chevron" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 6l4 4 4-4" />
              </svg>
            </span>
          </div>
        </summary>

        <div class="manual-body">
          <div class="manual-steps-grid">
            <!-- Step 1 -->
            <div class="step-card">
              <div class="step-num">01</div>
              <div class="step-info">
                <div class="step-heading">Install workspace dependencies</div>
                <p class="step-text">Clone the repository and install root workspace packages using pnpm.</p>
                <div class="code-box">
                  <code>git clone https://github.com/Cypher-0071/Home_Cloud.git &amp;&amp; cd Home_Cloud<br />pnpm install</code>
                </div>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="step-card">
              <div class="step-num">02</div>
              <div class="step-info">
                <div class="step-heading">Configure environment variables</div>
                <p class="step-text">Copy the template and define your root passcode and JWT signing key.</p>
                <div class="code-box">
                  <code>cp agent/.env.example agent/.env</code>
                </div>
                <p class="step-subtext">Set <code class="mono-inline">PASSWORD</code>, <code class="mono-inline">JWT_SECRET</code>, <code class="mono-inline">CF_DOMAIN</code>, and <code class="mono-inline">TUNNEL_NAME</code>.</p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="step-card">
              <div class="step-num">03</div>
              <div class="step-info">
                <div class="step-heading">Build production web desktop</div>
                <p class="step-text">Compile Vite + React 19 desktop artifacts into static distribution assets.</p>
                <div class="code-box">
                  <code>pnpm --filter dashboard build</code>
                </div>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="step-card">
              <div class="step-num">04</div>
              <div class="step-info">
                <div class="step-heading">Start control daemon</div>
                <p class="step-text">Launch the Express 5 + WebSocket server listening on port 3000.</p>
                <div class="code-box">
                  <code>pnpm --filter agent start</code>
                </div>
              </div>
            </div>
          </div>

          <div class="manual-footnote">
            <span class="mono-tag">PRODUCTION NOTE</span>
            <span>For persistent background operation, compile and install <code class="mono-inline">home-cloud.service.template</code> into <code class="mono-inline">/etc/systemd/system/</code>.</span>
          </div>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .install-section {
    background: var(--paper);
    border-top: 1px solid var(--rule);
    position: relative;
  }

  .header-eyebrow-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .spec-id {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }

  .install-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-4);
  }

  .install-lede {
    margin-bottom: var(--space-7);
  }

  /* 2-column Grid */
  .install-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: var(--space-6);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  @media (max-width: 960px) {
    .install-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Left Column: Spec Panel */
  .spec-panel {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-5);
    position: relative;
  }

  /* Corner crop marks */
  .spec-panel::before,
  .spec-panel::after {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    position: absolute;
    line-height: 1;
    pointer-events: none;
    opacity: 0.5;
  }
  .spec-panel::before {
    content: '+';
    top: 6px;
    left: 8px;
  }
  .spec-panel::after {
    content: '+';
    bottom: 6px;
    right: 8px;
  }

  .panel-tag-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-4);
  }

  .mono-tag {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    font-weight: 600;
  }

  .mono-subtag {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .mono-inline {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--paper-3);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    color: var(--ink);
  }

  /* Requirements list */
  .req-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .req-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .req-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    color: var(--ok);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .req-content {
    flex: 1;
  }

  .req-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
    margin-bottom: 2px;
  }

  .req-optional {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: normal;
    color: var(--ink-3);
  }

  .req-desc {
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.45;
  }

  /* Audit Callout */
  .audit-callout {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .audit-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .audit-bullet {
    width: 6px;
    height: 6px;
    background: var(--signal);
    border-radius: 50%;
  }

  .audit-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--signal-ink);
  }

  .audit-text {
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.45;
    margin-bottom: var(--space-3);
  }

  .audit-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .audit-link:hover {
    color: var(--signal-ink);
  }

  /* Hardware Strip */
  .hardware-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 520px) {
    .hardware-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
  }

  .hw-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hw-lbl {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .hw-val {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* Right Column: Night Terminal Card */
  .terminal-card {
    background: var(--night-2);
    border: 1px solid var(--night-rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-window);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Terminal Titlebar */
  .terminal-bar {
    background: var(--night-3);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--night-rule);
  }

  .terminal-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .terminal-indicator {
    width: 8px;
    height: 8px;
    background: var(--ok-night);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(91, 214, 138, 0.4);
  }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--night-text-2);
    letter-spacing: 0.04em;
  }

  .terminal-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .terminal-status {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.06);
    color: var(--night-text-2);
  }
  .terminal-status.is-running {
    background: rgb(255 77 23 / 0.16);
    color: var(--signal);
  }
  .terminal-status.is-done {
    background: rgb(91 214 138 / 0.16);
    color: var(--ok-night);
  }

  .term-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--night-text-2);
    background: transparent;
    border: 1px solid var(--night-rule);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .term-action-btn:hover {
    color: var(--night-text);
    border-color: rgba(241, 237, 228, 0.25);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Command Strip */
  .cmd-strip {
    background: var(--night);
    border-bottom: 1px solid var(--night-rule);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .cmd-inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cmd-inner::-webkit-scrollbar {
    display: none;
  }

  .cmd-prompt {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--signal);
    font-weight: 700;
    user-select: none;
  }

  .cmd-code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--night-text);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .cmd-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--night-3);
    border: 1px solid var(--night-rule);
    color: var(--night-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .cmd-copy-btn:hover {
    background: var(--signal);
    color: var(--night);
    border-color: var(--signal);
  }

  .cmd-copy-btn .icon-check {
    display: none;
  }
  .cmd-copy-btn.is-copied {
    background: var(--ok);
    color: var(--paper);
    border-color: var(--ok);
  }
  .cmd-copy-btn.is-copied .icon-copy {
    display: none;
  }
  .cmd-copy-btn.is-copied .icon-check {
    display: block;
  }

  /* Terminal Console */
  .terminal-console {
    background: var(--night-2);
    padding: var(--space-4);
    min-height: 290px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--night-text);
    overflow-y: auto;
    position: relative;
  }

  .log-stream {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  :global(.log-line) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    word-break: break-all;
    animation: termFadeIn 140ms ease-out forwards;
  }

  @keyframes termFadeIn {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  :global(.log-time) {
    color: var(--night-text-2);
    opacity: 0.6;
    user-select: none;
    flex-shrink: 0;
    font-size: 0.72rem;
  }

  :global(.log-icon-ok) {
    color: var(--ok-night);
    font-weight: bold;
    flex-shrink: 0;
  }

  :global(.log-icon-wait) {
    color: var(--warn);
    flex-shrink: 0;
  }

  :global(.log-icon-signal) {
    color: var(--signal);
    font-weight: bold;
    flex-shrink: 0;
  }

  :global(.log-text-signal) {
    color: var(--signal);
    font-weight: 600;
    background: rgba(255, 77, 23, 0.12);
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid rgba(255, 77, 23, 0.25);
  }

  :global(.log-text-success) {
    color: var(--ok-night);
    font-weight: 600;
  }

  .term-cursor-row {
    display: flex;
    align-items: center;
    margin-top: 4px;
    min-height: 14px;
  }

  .term-caret {
    display: inline-block;
    width: 7px;
    height: 13px;
    background: var(--night-text);
    animation: blinkCaret 1s steps(2, start) infinite;
  }

  @keyframes blinkCaret {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* Terminal Bottom Specs */
  .terminal-footer {
    background: var(--night-3);
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--night-rule);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tf-item {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--night-text-2);
    letter-spacing: 0.05em;
  }

  /* Manual Install Details */
  .manual-wrap {
    margin-top: var(--space-6);
  }

  .manual-details {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .manual-details[open] {
    border-color: var(--rule-strong);
  }

  .manual-summary {
    list-style: none;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    background: var(--paper-2);
    user-select: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .manual-summary::-webkit-details-marker {
    display: none;
  }
  .manual-summary:hover {
    background: var(--paper-3);
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .manual-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-weight: 600;
  }

  .summary-title {
    font-size: 0.95rem;
    font-weight: 550;
    color: var(--ink);
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .summary-hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .summary-chevron {
    transition: transform var(--dur-fast) var(--ease-out);
    color: var(--ink-2);
    display: flex;
    align-items: center;
  }
  .manual-details[open] .summary-chevron {
    transform: rotate(180deg);
  }

  .manual-body {
    padding: var(--space-5);
    border-top: 1px solid var(--rule);
    background: var(--paper);
  }

  .manual-steps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  @media (max-width: 768px) {
    .manual-steps-grid {
      grid-template-columns: 1fr;
    }
  }

  .step-card {
    display: flex;
    gap: var(--space-3);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--signal-ink);
    line-height: 1;
    flex-shrink: 0;
  }

  .step-info {
    flex: 1;
    min-width: 0;
  }

  .step-heading {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .step-text {
    font-size: 0.84rem;
    color: var(--ink-2);
    line-height: 1.45;
    margin-bottom: var(--space-2);
  }

  .step-subtext {
    font-size: 0.8rem;
    color: var(--ink-3);
    margin-top: var(--space-2);
  }

  .code-box {
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink);
    overflow-x: auto;
  }

  .manual-footnote {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: 0.84rem;
    color: var(--ink-2);
  }

  @media (max-width: 600px) {
    .manual-footnote {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>

<script>
  // Terminal log replay script with copy and reduced-motion support
  interface LogStep {
    time: string;
    icon: string;
    iconClass: string;
    text: string;
    highlightClass?: string;
    delay: number;
  }

  // ≈10 authentic lines from setup.sh exactly matching design brief
  const LOG_STEPS: LogStep[] = [
    {
      time: '00:01',
      icon: '⏳',
      iconClass: 'log-icon-wait',
      text: 'waiting for apt locks... released',
      delay: 160,
    },
    {
      time: '00:04',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'git ✓ (v2.43.0)',
      delay: 200,
    },
    {
      time: '00:18',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'Node.js 24 ✓',
      delay: 220,
    },
    {
      time: '00:29',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'pnpm ✓ (v10.4.0)',
      delay: 200,
    },
    {
      time: '01:02',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'Docker Engine + Compose ✓',
      delay: 260,
    },
    {
      time: '01:21',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'cloudflared ✓',
      delay: 220,
    },
    {
      time: '01:38',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'tunnel wizard: dash.you.dev ✓',
      delay: 240,
    },
    {
      time: '01:50',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'generated agent/.env (password hidden) ✓',
      delay: 240,
    },
    {
      time: '02:35',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'built dashboard ✓ (dist/ ready in 4.81s)',
      delay: 260,
    },
    {
      time: '02:50',
      icon: '✔',
      iconClass: 'log-icon-ok',
      text: 'systemctl enable --now home-cloud ✓',
      delay: 260,
    },
    {
      time: '02:52',
      icon: '→',
      iconClass: 'log-icon-signal',
      text: 'open http://192.168.1.42:3000',
      highlightClass: 'log-text-signal',
      delay: 300,
    },
  ];

  function initInstallTerminal() {
    const card = document.getElementById('install-terminal');
    const stream = document.getElementById('term-log-stream');
    const statusBadge = document.getElementById('term-status-badge');
    const replayBtn = document.getElementById('term-replay-btn');
    const copyBtn = document.getElementById('term-copy-btn');
    const cmdText = document.getElementById('install-cmd-text');

    if (!card || !stream || !statusBadge) return;

    let isPlaying = false;
    let hasPlayed = false;
    let timerId: number | null = null;

    // Clipboard copy handler
    if (copyBtn && cmdText) {
      copyBtn.addEventListener('click', async () => {
        const textToCopy = cmdText.textContent?.trim() || '';
        try {
          await navigator.clipboard.writeText(textToCopy);
          copyBtn.classList.add('is-copied');
          const label = copyBtn.querySelector('.copy-label');
          if (label) label.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.classList.remove('is-copied');
            if (label) label.textContent = 'Copy';
          }, 1600);
        } catch (err) {
          console.error('Failed to copy', err);
        }
      });
    }

    function renderLine(step: LogStep) {
      const line = document.createElement('div');
      line.className = 'log-line';

      const time = document.createElement('span');
      time.className = 'log-time';
      time.textContent = `[${step.time}]`;

      const icon = document.createElement('span');
      icon.className = step.iconClass;
      icon.textContent = step.icon;

      const body = document.createElement('span');
      if (step.highlightClass) {
        body.className = step.highlightClass;
      }
      body.textContent = ` ${step.text}`;

      line.appendChild(time);
      line.appendChild(icon);
      line.appendChild(body);
      stream?.appendChild(line);

      // Auto-scroll console
      const consoleEl = document.getElementById('term-console');
      if (consoleEl) {
        consoleEl.scrollTop = consoleEl.scrollHeight;
      }
    }

    function stopReplay() {
      if (timerId !== null) {
        window.clearTimeout(timerId);
        timerId = null;
      }
      isPlaying = false;
    }

    function playReplay() {
      stopReplay();
      isPlaying = true;
      statusBadge!.textContent = 'RUNNING';
      statusBadge!.className = 'terminal-status is-running';

      if (!stream) return;
      stream.innerHTML = '';

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReduced) {
        // Render all lines immediately
        for (const step of LOG_STEPS) {
          renderLine(step);
        }
        statusBadge!.textContent = 'COMPLETE';
        statusBadge!.className = 'terminal-status is-done';
        isPlaying = false;
        hasPlayed = true;
        return;
      }

      let index = 0;
      function next() {
        if (document.hidden) {
          // Pause if tab is inactive
          timerId = window.setTimeout(next, 500);
          return;
        }

        if (index < LOG_STEPS.length) {
          const step = LOG_STEPS[index];
          renderLine(step);
          index++;
          timerId = window.setTimeout(next, step.delay);
        } else {
          statusBadge!.textContent = 'COMPLETE';
          statusBadge!.className = 'terminal-status is-done';
          isPlaying = false;
          hasPlayed = true;
        }
      }

      next();
    }

    // Replay button listener
    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        playReplay();
      });
    }

    // Scroll-triggered autoplay via IntersectionObserver
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !hasPlayed && !isPlaying) {
              playReplay();
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.25 }
      );
      io.observe(card);
    } else {
      playReplay();
    }
  }

  // Run on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstallTerminal);
  } else {
    initInstallTerminal();
  }
</script>
