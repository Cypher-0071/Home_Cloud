<script>
  // 1. Reveal staggered headline on mount
  const heroSec = document.getElementById('top');
  if (heroSec) {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    if (prefersReduced) {
      heroSec.classList.add('is-revealed');
    } else {
      // Small frame delay to let paint settle for maximum smoothness
      requestAnimationFrame(() => {
        heroSec.classList.add('is-revealed');
      });
    }
  }

  // 2. Install command copy button handler
  const copyBtn = document.getElementById('hero-copy-btn');
  if (copyBtn) {
    let copyTimer: number | undefined;

    copyBtn.addEventListener('click', async () => {
      const textToCopy = copyBtn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(textToCopy);
      } catch {
        // Fallback for non-secure contexts
        const textarea = document.createElement('textarea');
        textarea.value = textToCopy;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }

      copyBtn.classList.add('is-copied');
      copyBtn.setAttribute('aria-label', 'Command copied to clipboard');

      if (copyTimer) clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => {
        copyBtn.classList.remove('is-copied');
        copyBtn.setAttribute('aria-label', 'Copy install command');
      }, 1600);
    });
  }

  // 3. Topology SVG animation lifecycle (pause when off-screen or tab hidden)
  const topoSvg = document.getElementById(
    'topology-svg',
  ) as SVGSVGElement | null;
  if (topoSvg && 'pauseAnimations' in topoSvg) {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    if (prefersReduced) {
      try {
        topoSvg.pauseAnimations();
      } catch {}
    } else {
      if ('IntersectionObserver' in window) {
        const topoObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              try {
                if (entry.isIntersecting && !document.hidden) {
                  topoSvg.unpauseAnimations();
                } else {
                  topoSvg.pauseAnimations();
                }
              } catch {}
            }
          },
          { threshold: 0.05 },
        );
        topoObserver.observe(topoSvg);
      }

      document.addEventListener('visibilitychange', () => {
        try {
          if (document.hidden) {
            topoSvg.pauseAnimations();
          } else {
            topoSvg.unpauseAnimations();
          }
        } catch {}
      });
    }
  }
</script>
