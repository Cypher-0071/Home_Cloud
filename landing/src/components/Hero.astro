---
// landing/src/components/Hero.astro — §00 Hero (id="top")
// Staggered headline reveal, copyable install command pill,
// FIG. 1 animated topology SVG with packets passing over the router,
// and 4-cell datasheet stat row with hairline dividers.
---

<section id="top" class="hero-section section">
  <div class="container hero-container">
    <!-- Top row: Section Eyebrow + Spec Strip -->
    <div class="hero-top-strip">
      <span class="eyebrow">§ 00 — Open source · Self-hosted · Linux</span>
      <div class="hero-spec-strip" aria-label="System compatibility specs">
        <span class="spec-token">NODE 24</span>
        <span class="spec-sep" aria-hidden="true">·</span>
        <span class="spec-token">DOCKER</span>
        <span class="spec-sep" aria-hidden="true">·</span>
        <span class="spec-token">CLOUDFLARE TUNNEL</span>
        <span class="spec-sep" aria-hidden="true">·</span>
        <span class="spec-token">x86_64 / arm64</span>
      </div>
    </div>

    <!-- Main Headline with staggered word mask-reveal -->
    <h1
      class="display hero-headline"
      id="hero-headline"
      aria-label="The cloud is just someone else's computer. Make it yours."
    >
      <span class="headline-line line-1" aria-hidden="true">
        <span class="word-mask"><span class="word-inner" style="--w-idx: 0">The</span></span>
        <span class="word-mask"><span class="word-inner" style="--w-idx: 1">cloud</span></span>
        <span class="word-mask"><span class="word-inner" style="--w-idx: 2">is</span></span>
        <span class="word-mask"><span class="word-inner" style="--w-idx: 3">just</span></span>
        <span class="word-mask"><span class="word-inner" style="--w-idx: 4">someone</span></span>
        <span class="word-mask"><span class="word-inner" style="--w-idx: 5">else's</span></span>
        <span class="word-mask"><span class="word-inner" style="--w-idx: 6">computer.</span></span>
      </span>
      <span class="headline-line line-2" aria-hidden="true">
        <em>
          <span class="word-mask"><span class="word-inner" style="--w-idx: 7">Make</span></span>
          <span class="word-mask"><span class="word-inner" style="--w-idx: 8">it</span></span>
          <span class="word-mask"><span class="word-inner" style="--w-idx: 9">yours.</span></span>
        </em>
      </span>
    </h1>

    <!-- Lede paragraph -->
    <p class="lede hero-lede">
      Home Cloud turns the spare Linux box in your closet into a private cloud
      you can reach from any browser — desktop, terminal, files and Docker —
      through a Cloudflare Tunnel. Behind CGNAT. Zero ports opened.
    </p>

    <!-- Actions: Copyable install pill + GitHub ghost button -->
    <div class="hero-actions">
      <div
        class="install-pill"
        role="region"
        aria-label="One-command install snippet"
      >
        <span class="pill-prompt" aria-hidden="true">$</span>
        <div class="pill-code-container">
          <code
            class="pill-code"
            id="hero-install-cmd"
          >curl -fsSL https://raw.githubusercontent.com/Cypher-0071/Home_Cloud/main/setup.sh -o setup.sh &amp;&amp; chmod +x setup.sh &amp;&amp; ./setup.sh</code>
        </div>
        <button
          type="button"
          class="pill-copy-btn"
          id="hero-copy-btn"
          aria-label="Copy install command"
          data-copy="curl -fsSL https://raw.githubusercontent.com/Cypher-0071/Home_Cloud/main/setup.sh -o setup.sh && chmod +x setup.sh && ./setup.sh"
        >
          <span class="copy-default">
            <svg
              class="copy-svg"
              viewBox="0 0 16 16"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="5" y="5" width="9" height="9" rx="1.5"></rect>
              <path d="M11 2H3.5A1.5 1.5 0 0 0 2 3.5V11"></path>
            </svg>
            <span class="copy-label">Copy</span>
          </span>
          <span class="copy-success" aria-hidden="true">
            <svg
              class="check-svg"
              viewBox="0 0 16 16"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
            </svg>
            <span class="copy-label">Copied</span>
          </span>
        </button>
      </div>

      <a
        href="https://github.com/Cypher-0071/Home_Cloud"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost hero-gh-btn"
        aria-label="Star Home Cloud on GitHub"
      >
        <svg
          class="gh-icon"
          viewBox="0 0 16 16"
          width="16"
          height="16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span>Star on GitHub</span>
      </a>
    </div>

    <!-- FIG. 1 — Topology Visual -->
    <div class="topology-wrapper">
      <!-- 4 crop marks at the corners of key figures -->
      <span class="crop-mark top-left" aria-hidden="true">+</span>
      <span class="crop-mark top-right" aria-hidden="true">+</span>
      <span class="crop-mark bottom-left" aria-hidden="true">+</span>
      <span class="crop-mark bottom-right" aria-hidden="true">+</span>

      <div class="topology-box">
        <!-- Technical header bar -->
        <div class="topology-topbar">
          <div class="topo-topbar-left">
            <span class="topo-fig-id">FIG. 1 — TOPOLOGY</span>
            <span class="topo-fig-title">// CONTROL &amp; DATA PLANES</span>
          </div>
          <div class="topo-topbar-right">
            <span class="topo-meta-item">OUTBOUND TUNNEL ARCHITECTURE</span>
            <span class="topo-meta-sep">·</span>
            <span class="topo-meta-item">PORT 3000 · SSE / 2s</span>
          </div>
        </div>

        <!-- Inline SVG Technical Diagram -->
        <div class="topology-svg-wrap">
          <svg
            id="topology-svg"
            class="topology-svg"
            viewBox="0 0 1080 430"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-label="FIG. 1: Home Cloud network topology diagram showing outbound tunnel from PC to Cloudflare Edge passing over the router"
          >
            <defs>
              <!-- Faint technical dot grid -->
              <pattern
                id="topo-dot-grid"
                x="0"
                y="0"
                width="20"
                height="20"
                patternUnits="userSpaceOnUse"
              >
                <circle cx="2" cy="2" r="0.8" fill="var(--ink)" opacity="0.12"
                ></circle>
              </pattern>
            </defs>

            <!-- Grid background -->
            <rect
              width="100%"
              height="100%"
              fill="url(#topo-dot-grid)"
              opacity="0.9"
            ></rect>

            <!-- Hairline baseline rule -->
            <line
              x1="30"
              y1="390"
              x2="1050"
              y2="390"
              stroke="var(--rule)"
              stroke-width="1"
            ></line>

            <!-- =========================================================
                 1. OUTBOUND TUNNEL PATH (PC -> Edge passing OVER router)
                 ========================================================= -->
            <!-- The Arched Tunnel: passes 85px above the router -->
            <path
              id="path-tunnel-pc-to-edge"
              d="M 145 195 C 220 75, 640 75, 715 195"
              fill="none"
              stroke="var(--ink)"
              stroke-width="2"
              stroke-dasharray="6 4"
            ></path>

            <!-- Return path for reversed motion: Edge -> PC -->
            <path
              id="path-tunnel-edge-to-pc"
              d="M 715 195 C 640 75, 220 75, 145 195"
              fill="none"
              stroke="transparent"
            ></path>

            <!-- Tunnel Label Badge floating at apex -->
            <g transform="translate(430, 72)">
              <rect
                x="-135"
                y="-20"
                width="270"
                height="38"
                rx="4"
                fill="var(--paper)"
                stroke="var(--rule-strong)"
                stroke-width="1.2"
              ></rect>
              <text
                x="0"
                y="-3"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="11"
                font-weight="700"
                letter-spacing="0.08em"
                fill="var(--ink)"
              >outbound QUIC</text>
              <text
                x="0"
                y="11"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="8.5"
                font-weight="600"
                fill="var(--signal-ink)"
                letter-spacing="0.04em"
              >PASSES OVER ROUTER · ZERO INBOUND PORTS</text>
            </g>

            <!-- =========================================================
                 2. DEVICE <-> CLOUDFLARE EDGE CONNECTION
                 ========================================================= -->
            <line
              x1="805"
              y1="270"
              x2="875"
              y2="270"
              stroke="var(--ink)"
              stroke-width="2"
            ></line>

            <!-- Hidden explicit paths for packet animation -->
            <path
              id="path-dev-to-edge"
              d="M 875 270 L 805 270"
              stroke="transparent"
              fill="none"
            ></path>
            <path
              id="path-edge-to-dev"
              d="M 805 270 L 875 270"
              stroke="transparent"
              fill="none"
            ></path>

            <!-- Device Connection Labels -->
            <text
              x="840"
              y="253"
              text-anchor="middle"
              font-family="var(--font-mono)"
              font-size="10"
              font-weight="700"
              fill="var(--signal-ink)"
            >https://dash.you.dev</text>
            <text
              x="840"
              y="290"
              text-anchor="middle"
              font-family="var(--font-mono)"
              font-size="8.5"
              letter-spacing="0.05em"
              fill="var(--ink-3)"
            >TLS 1.3 / HTTPS</text>

            <!-- =========================================================
                 3. ANIMATED VERMILION PACKETS
                 ========================================================= -->
            <!-- Packet 1: Request Device -> Edge -->
            <g class="topo-packet">
              <circle r="3.5" fill="var(--signal)">
                <animateMotion
                  path="M 875 270 L 805 270"
                  dur="1.2s"
                  repeatCount="indefinite"
                ></animateMotion>
              </circle>
              <circle r="7" fill="var(--signal)" opacity="0.25">
                <animateMotion
                  path="M 875 270 L 805 270"
                  dur="1.2s"
                  repeatCount="indefinite"
                ></animateMotion>
              </circle>
            </g>

            <!-- Packet 2: Request forwarded Edge -> PC along Tunnel -->
            <g class="topo-packet">
              <circle r="3.5" fill="var(--signal)">
                <animateMotion
                  path="M 715 195 C 640 75, 220 75, 145 195"
                  dur="2.4s"
                  repeatCount="indefinite"
                ></animateMotion>
              </circle>
              <circle r="7" fill="var(--signal)" opacity="0.25">
                <animateMotion
                  path="M 715 195 C 640 75, 220 75, 145 195"
                  dur="2.4s"
                  repeatCount="indefinite"
                ></animateMotion>
              </circle>
            </g>

            <!-- Packet 3: Response PC -> Edge along Tunnel -->
            <g class="topo-packet">
              <circle r="3.5" fill="var(--signal)">
                <animateMotion
                  path="M 145 195 C 220 75, 640 75, 715 195"
                  dur="2.4s"
                  begin="1.2s"
                  repeatCount="indefinite"
                ></animateMotion>
              </circle>
              <circle r="7" fill="var(--signal)" opacity="0.25">
                <animateMotion
                  path="M 145 195 C 220 75, 640 75, 715 195"
                  dur="2.4s"
                  begin="1.2s"
                  repeatCount="indefinite"
                ></animateMotion>
              </circle>
            </g>

            <!-- Packet 4: Response delivered Edge -> Device -->
            <g class="topo-packet">
              <circle r="3.5" fill="var(--signal)">
                <animateMotion
                  path="M 805 270 L 875 270"
                  dur="1.2s"
                  begin="0.6s"
                  repeatCount="indefinite"
                ></animateMotion>
              </circle>
              <circle r="7" fill="var(--signal)" opacity="0.25">
                <animateMotion
                  path="M 805 270 L 875 270"
                  dur="1.2s"
                  begin="0.6s"
                  repeatCount="indefinite"
                ></animateMotion>
              </circle>
            </g>

            <!-- =========================================================
                 NODE 1: YOUR PC
                 ========================================================= -->
            <g class="topo-node" id="node-pc">
              <!-- Label above box -->
              <text
                x="145"
                y="162"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="12.5"
                font-weight="700"
                letter-spacing="0.08em"
                fill="var(--ink)"
              >YOUR PC</text>
              <text
                x="145"
                y="178"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="9.5"
                fill="var(--ink-3)"
              >closet · "lid closed, always on"</text>

              <!-- Node Card Box -->
              <rect
                x="55"
                y="195"
                width="180"
                height="155"
                rx="6"
                fill="var(--paper-2)"
                stroke="var(--ink)"
                stroke-width="1.6"
              ></rect>

              <!-- Tunnel Attachment Port -->
              <circle
                cx="145"
                y="195"
                r="4.5"
                fill="var(--paper)"
                stroke="var(--ink)"
                stroke-width="2"
              ></circle>

              <!-- Server Chassis Glyph -->
              <rect
                x="72"
                y="218"
                width="146"
                height="62"
                rx="4"
                fill="var(--paper)"
                stroke="var(--rule-strong)"
                stroke-width="1.2"
              ></rect>

              <!-- Drive slots -->
              <line
                x1="84"
                y1="233"
                x2="155"
                y2="233"
                stroke="var(--rule-strong)"
                stroke-width="1.5"
              ></line>
              <line
                x1="84"
                y1="243"
                x2="155"
                y2="243"
                stroke="var(--rule-strong)"
                stroke-width="1.5"
              ></line>
              <line
                x1="84"
                y1="253"
                x2="155"
                y2="253"
                stroke="var(--rule-strong)"
                stroke-width="1.5"
              ></line>

              <!-- Status LED (green pulse) -->
              <circle cx="196" cy="235" r="3.5" fill="var(--ok)"></circle>
              <circle
                cx="196"
                cy="235"
                r="7"
                fill="none"
                stroke="var(--ok)"
                stroke-width="1"
                opacity="0.4"
                class="pulsing-led"
              ></circle>
              <text
                x="196"
                y="255"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="7.5"
                fill="var(--ok)"
                font-weight="600"
              >RUN</text>

              <!-- Daemon specs inside card -->
              <text
                x="145"
                y="302"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="9.5"
                font-weight="700"
                fill="var(--ink)"
              >PORT 3000 · systemd</text>
              <text
                x="145"
                y="318"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="8.5"
                fill="var(--ink-3)"
              >Express 5 + ws · 192.168.1.42</text>
              <text
                x="145"
                y="334"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="8"
                letter-spacing="0.04em"
                fill="var(--signal-ink)"
                font-weight="600"
              >DOCKER COMPOSE + PTY</text>
            </g>

            <!-- =========================================================
                 NODE 2: ROUTER (with 0 INBOUND PORTS stamp)
                 ========================================================= -->
            <g class="topo-node" id="node-router">
              <!-- Label above box -->
              <text
                x="430"
                y="162"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="12.5"
                font-weight="700"
                letter-spacing="0.08em"
                fill="var(--ink)"
              >ROUTER</text>
              <text
                x="430"
                y="178"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="9.5"
                fill="var(--ink-3)"
              >ISP gateway · firewall</text>

              <!-- Node Card Box -->
              <rect
                x="340"
                y="195"
                width="180"
                height="155"
                rx="6"
                fill="var(--paper-2)"
                stroke="var(--rule-strong)"
                stroke-width="1.6"
              ></rect>

              <!-- Antennas -->
              <line
                x1="400"
                y1="195"
                x2="385"
                y2="172"
                stroke="var(--ink-3)"
                stroke-width="2"
                stroke-linecap="round"
              ></line>
              <line
                x1="460"
                y1="195"
                x2="475"
                y2="172"
                stroke="var(--ink-3)"
                stroke-width="2"
                stroke-linecap="round"
              ></line>

              <!-- Blocked Inbound WAN Arrow probe -->
              <g transform="translate(305, 260)">
                <line
                  x1="-35"
                  y1="0"
                  x2="15"
                  y2="0"
                  stroke="var(--signal-ink)"
                  stroke-width="1.5"
                  stroke-dasharray="3 3"
                ></line>
                <circle
                  cx="20"
                  cy="0"
                  r="7.5"
                  fill="var(--paper)"
                  stroke="var(--signal-ink)"
                  stroke-width="1.5"
                ></circle>
                <line
                  x1="16"
                  y1="-4"
                  x2="24"
                  y2="4"
                  stroke="var(--signal-ink)"
                  stroke-width="1.8"
                ></line>
                <line
                  x1="24"
                  y1="-4"
                  x2="16"
                  y2="4"
                  stroke="var(--signal-ink)"
                  stroke-width="1.8"
                ></line>
                <text
                  x="-10"
                  y="-8"
                  text-anchor="middle"
                  font-family="var(--font-mono)"
                  font-size="7.5"
                  font-weight="700"
                  fill="var(--signal-ink)"
                >WAN INBOUND</text>
                <text
                  x="-10"
                  y="13"
                  text-anchor="middle"
                  font-family="var(--font-mono)"
                  font-size="7.5"
                  font-weight="600"
                  fill="var(--signal-ink)"
                >BLOCKED</text>
              </g>

              <!-- THE STAMP: 0 INBOUND PORTS / CGNAT -->
              <g transform="translate(430, 245) rotate(-5)">
                <rect
                  x="-68"
                  y="-22"
                  width="136"
                  height="44"
                  rx="3"
                  fill="color-mix(in srgb, var(--paper) 92%, var(--signal))"
                  stroke="var(--signal-ink)"
                  stroke-width="1.8"
                ></rect>
                <rect
                  x="-65"
                  y="-19"
                  width="130"
                  height="38"
                  rx="2"
                  fill="none"
                  stroke="var(--signal-ink)"
                  stroke-width="0.8"
                  stroke-dasharray="3 2"
                ></rect>
                <text
                  x="0"
                  y="-4"
                  text-anchor="middle"
                  font-family="var(--font-mono)"
                  font-size="10"
                  font-weight="800"
                  letter-spacing="0.08em"
                  fill="var(--signal-ink)"
                >0 INBOUND PORTS</text>
                <text
                  x="0"
                  y="11"
                  text-anchor="middle"
                  font-family="var(--font-mono)"
                  font-size="8.5"
                  font-weight="700"
                  letter-spacing="0.06em"
                  fill="var(--signal-ink)"
                >CGNAT ACTIVE</text>
              </g>

              <!-- Router spec text -->
              <text
                x="430"
                y="312"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="9"
                fill="var(--ink)"
              >NO PORT FORWARDING</text>
              <text
                x="430"
                y="328"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="8.5"
                fill="var(--ink-3)"
              >uPnP Disabled · NAT Jailed</text>
            </g>

            <!-- =========================================================
                 NODE 3: CLOUDFLARE EDGE
                 ========================================================= -->
            <g class="topo-node" id="node-edge">
              <!-- Label above box -->
              <text
                x="715"
                y="162"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="12.5"
                font-weight="700"
                letter-spacing="0.08em"
                fill="var(--ink)"
              >CLOUDFLARE EDGE</text>
              <text
                x="715"
                y="178"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="9.5"
                font-weight="600"
                fill="var(--signal-ink)"
              >"TLS terminates here"</text>

              <!-- Node Card Box -->
              <rect
                x="625"
                y="195"
                width="180"
                height="155"
                rx="6"
                fill="var(--paper-2)"
                stroke="var(--ink)"
                stroke-width="1.6"
              ></rect>

              <!-- Tunnel Attachment Port -->
              <circle
                cx="715"
                y="195"
                r="4.5"
                fill="var(--paper)"
                stroke="var(--ink)"
                stroke-width="2"
              ></circle>

              <!-- Lock & Cloud Icon Plaque -->
              <g transform="translate(715, 235)">
                <!-- Padlock -->
                <rect
                  x="-9"
                  y="-5"
                  width="18"
                  height="14"
                  rx="2.5"
                  fill="var(--ink)"
                ></rect>
                <path
                  d="M-5 -5 V-10 C-5 -13 5 -13 5 -10 V-5"
                  fill="none"
                  stroke="var(--ink)"
                  stroke-width="1.8"
                ></path>
                <circle cx="0" cy="1" r="1.5" fill="var(--paper)"></circle>
              </g>

              <!-- Subdomain chip -->
              <rect
                x="640"
                y="256"
                width="150"
                height="24"
                rx="3"
                fill="var(--paper)"
                stroke="var(--rule-strong)"
                stroke-width="1"
              ></rect>
              <text
                x="715"
                y="272"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="9"
                font-weight="600"
                fill="var(--ink)"
              >*.yourdomain.com</text>

              <!-- Edge Specs -->
              <text
                x="715"
                y="302"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="9.5"
                font-weight="700"
                fill="var(--ink)"
              >Anycast · 330+ Cities</text>
              <text
                x="715"
                y="318"
                text-anchor="middle"
                font-family="var(--font-mono)"
                font-size="8.5"
