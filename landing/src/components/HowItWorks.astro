---
// HowItWorks.astro — §03 How it works ("Paper & Signal")
---

<section class="section how-section" id="how">
  <div class="container">
    <!-- Section Header -->
    <header class="how-header reveal">
      <span class="eyebrow">§ 03 — How it works</span>
      <h2 class="display how-title">Three steps from closet <em>to cloud.</em></h2>
      <p class="lede how-lede">
        Zero router port forwarding. Zero dynamic DNS hacks. Zero open firewall holes. The automated setup wires an outbound-only encrypted tunnel from your closet directly to Cloudflare's edge network.
      </p>
    </header>

    <!-- 3 Numbered Steps with Self-Drawing Connector Line -->
    <div class="steps-wrapper reveal" style="--reveal-delay: 80ms">
      <!-- Desktop SVG Connecting Hairline -->
      <div class="connector-track" aria-hidden="true">
        <svg class="connector-svg" viewBox="0 0 1000 40" preserveAspectRatio="none">
          <line
            class="connector-base"
            x1="120"
            y1="20"
            x2="880"
            y2="20"
          />
          <path
            id="how-step-line"
            class="connector-draw"
            d="M 120 20 L 500 20 L 880 20"
          />
          <circle id="how-step-dot" class="connector-tracer" cx="120" cy="20" r="3.5" />
        </svg>
      </div>

      <div class="steps-grid">
        <!-- Step 1: Install -->
        <article class="step-item" data-step="1">
          <div class="step-num-wrap">
            <span class="step-num">1</span>
            <span class="step-node-point" aria-hidden="true"></span>
          </div>
          <div class="step-content">
            <div class="step-meta">
              <span class="step-idx">STEP 01</span>
              <span class="step-phase">HOST BOOTSTRAP</span>
            </div>
            <h3 class="step-title">Install</h3>
            <p class="step-desc">
              Run <code>./setup.sh</code> on your Linux machine. The installer verifies dependencies, clears apt locks, installs Node.js 24, pnpm, Docker Engine, the Compose plugin, cloudflared, and configures a systemd unit.
            </p>
            <div class="step-foot">
              <code>curl -fsSL ... | bash</code>
              <span class="step-chip">SYSTEMD ENABLED</span>
            </div>
          </div>
        </article>

        <!-- Step 2: Tunnel -->
        <article class="step-item" data-step="2">
          <div class="step-num-wrap">
            <span class="step-num">2</span>
            <span class="step-node-point" aria-hidden="true"></span>
          </div>
          <div class="step-content">
            <div class="step-meta">
              <span class="step-idx">STEP 02</span>
              <span class="step-phase">EDGE INGRESS</span>
            </div>
            <h3 class="step-title">Tunnel</h3>
            <p class="step-desc">
              The interactive wizard pairs with your Cloudflare account, provisions a dedicated named tunnel, and generates wildcard DNS records for <code>dash.you.dev</code> and <code>*.you.dev</code>.
            </p>
            <div class="step-foot">
              <code>outbound QUIC · 0 ports</code>
              <span class="step-chip">TLS EDGE</span>
            </div>
          </div>
        </article>

        <!-- Step 3: Reach -->
        <article class="step-item" data-step="3">
          <div class="step-num-wrap">
            <span class="step-num">3</span>
            <span class="step-node-point" aria-hidden="true"></span>
          </div>
          <div class="step-content">
            <div class="step-meta">
              <span class="step-idx">STEP 03</span>
              <span class="step-phase">DUAL-PATH ACCESS</span>
            </div>
            <h3 class="step-title">Reach</h3>
            <p class="step-desc">
              Log in from any browser on earth. When you are on your local home network, it automatically switches to LAN direct connection for zero-latency streaming and file transfers.
            </p>
            <div class="step-foot">
              <code>split-horizon LAN · 7d JWT</code>
              <span class="step-chip is-ok">LAN AUTODETECT</span>
            </div>
          </div>
        </article>
      </div>
    </div>

    <!-- FIG. 2 — Two planes diagram -->
    <div class="fig2-wrapper reveal" style="--reveal-delay: 140ms">
      <div class="fig2-strip">
        <div class="fig2-strip-left">
          <span class="fig-id">FIG. 2 — TWO PLANES</span>
          <span class="fig-title">Control Plane vs Data Plane Architecture</span>
        </div>
        <div class="fig2-strip-right">
          <span class="fig-spec">CLOUDFLARE INGRESS // AUTO-WIRED TOPOLOGY</span>
        </div>
      </div>

      <div class="fig2-box">
        <span class="crop-mark top-left" aria-hidden="true">+</span>
        <span class="crop-mark top-right" aria-hidden="true">+</span>
        <span class="crop-mark bottom-left" aria-hidden="true">+</span>
        <span class="crop-mark bottom-right" aria-hidden="true">+</span>

        <div class="fig2-grid">
          <!-- Left Column: Two Planes Architectural Schema -->
          <div class="fig2-schematic">
            <!-- Plane A: Control Plane -->
            <div class="plane-card plane-control">
              <div class="plane-card-head">
                <div class="plane-id-row">
                  <span class="plane-badge">PLANE 01</span>
                  <span class="plane-type">CONTROL PLANE</span>
                </div>
                <div class="plane-port-tag">PORT 3000</div>
              </div>

              <div class="plane-route">
                <span class="route-host">dash.you.dev</span>
                <span class="route-arrow" aria-hidden="true">──[tunnel]──▶</span>
                <span class="route-dest">agent :3000</span>
              </div>

              <p class="plane-desc">
                Houses the multitasking web desktop, REST API, WebSocket PTY shell, and live telemetry. Protected by a single-user passcode issuing an httpOnly 7-day JWT. Effectively host root.
              </p>

              <div class="plane-chips">
                <span class="chip-item">Web Desktop (React 19)</span>
                <span class="chip-item">Host PTY Shell</span>
                <span class="chip-item">SSE Metrics</span>
                <span class="chip-item">Docker API</span>
              </div>
            </div>

            <!-- Inter-plane hairline boundary -->
            <div class="plane-divider">
              <span class="div-line"></span>
              <span class="div-label">TRAFFIC SEPARATION BOUNDARY</span>
              <span class="div-line"></span>
            </div>

            <!-- Plane B: Data Plane -->
            <div class="plane-card plane-data">
              <div class="plane-card-head">
                <div class="plane-id-row">
                  <span class="plane-badge is-data">PLANE 02</span>
                  <span class="plane-type">DATA PLANE</span>
                </div>
                <div class="plane-port-tag is-signal">CONTAINER PORTS</div>
              </div>

              <div class="plane-route">
                <span class="route-host">&lt;app&gt;.you.dev</span>
                <span class="route-arrow" aria-hidden="true">──[tunnel]──▶</span>
                <span class="route-dest">host port (:8096, :2283…)</span>
              </div>

              <p class="plane-desc">
                App traffic bypasses the Node agent entirely. Heavy media streams, file syncs, and dedicated web UIs flow straight between Cloudflare edge and the target container. Zero proxy overhead.
              </p>

              <div class="plane-chips">
                <span class="chip-item">Direct Port Proxy</span>
                <span class="chip-item">Zero Node CPU Load</span>
                <span class="chip-item">Independent Origin</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Mini Ingress YAML Config -->
          <div class="fig2-code-col">
            <div class="yaml-viewer">
              <div class="yaml-head">
                <div class="yaml-file-info">
                  <span class="yaml-glyph" aria-hidden="true">⚙</span>
                  <span class="yaml-path">~/.cloudflared/config.yml</span>
                </div>
                <div class="yaml-status">
                  <span class="yaml-dot" aria-hidden="true"></span>
                  <span>AUTOWIRED RULES</span>
                </div>
              </div>

              <div class="yaml-code-wrap">
                <pre class="yaml-pre"><code><span class="yaml-k">ingress</span>:
  - <span class="yaml-k">hostname</span>: <span class="yaml-s">dash.you.dev</span>
    <span class="yaml-k">service</span>: <span class="yaml-s">http://localhost:3000</span>
<mark class="yaml-highlight">  - <span class="yaml-k">hostname</span>: <span class="yaml-s">jellyfin.you.dev</span>     <span class="yaml-tag">[AUTO-ADDED]</span>
    <span class="yaml-k">service</span>: <span class="yaml-s">http://localhost:8096</span></mark>
  - <span class="yaml-k">service</span>: <span class="yaml-s">http_status:404</span></code></pre>
              </div>

              <div class="yaml-footer">
                <div class="yaml-footer-indicator">
                  <span class="signal-indicator" aria-hidden="true"></span>
                  <span class="yaml-footer-title">AUTOMATIC INGRESS SYNC</span>
                </div>
                <p class="yaml-footer-text">
                  When you expose a container through Home Cloud, the agent appends the hostname rule and commands cloudflared to reload ingress tables. The route goes live in under 200ms with zero downtime.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     How It Works Section Styles — Paper-2 Background Band
     ========================================================================== */

  .how-section {
    background: var(--paper-2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .how-header {
    margin-bottom: var(--space-8);
  }

  .how-title {
    font-size: var(--step-3);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .how-lede {
    max-width: 68ch;
  }

  /* ==========================================================================
     3 Numbered Steps & Connecting Line
     ========================================================================== */

  .steps-wrapper {
    position: relative;
    margin-bottom: var(--space-9);
  }

  /* Desktop SVG Connecting Hairline Track */
  .connector-track {
    position: absolute;
    top: 36px;
    left: 0;
    right: 0;
    height: 40px;
    pointer-events: none;
    z-index: 1;
  }

  .connector-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .connector-base {
    stroke: var(--rule-strong);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    opacity: 0.5;
  }

  .connector-draw {
    stroke: var(--signal);
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.1s linear;
  }

  .connector-tracer {
    fill: var(--signal);
    filter: drop-shadow(0 0 4px rgba(255, 77, 23, 0.4));
    transition: cx 0.1s linear, cy 0.1s linear;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    position: relative;
    z-index: 2;
  }

  .step-item {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .step-item:hover {
    border-color: var(--rule-strong);
    background: var(--paper);
  }

  .step-num-wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .step-num {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 2.8rem + 1.8vw, 4.6rem);
    line-height: 0.9;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.04em;
  }

  .step-node-point {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--signal);
    background: var(--paper);
  }

  .step-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .step-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
  }

  .step-idx {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--signal-ink);
  }

  .step-phase {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .step-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    color: var(--ink);
    margin-bottom: var(--space-2);
    letter-spacing: -0.015em;
  }

  .step-desc {
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--ink-2);
    margin-bottom: var(--space-5);
    flex: 1;
  }

  .step-desc code {
    background: var(--paper-2);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
    font-size: 0.88em;
  }

  .step-foot {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--rule);
    font-family: var(--font-mono);
  }

  .step-foot code {
    font-size: 0.74rem;
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .step-chip {
    align-self: flex-start;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 2px 6px;
  }

  .step-chip.is-ok {
    color: var(--ok);
    border-color: rgba(31, 122, 85, 0.3);
  }

  /* ==========================================================================
     FIG. 2 — Two Planes Architecture Spec
     ========================================================================== */

  .fig2-wrapper {
    position: relative;
  }

  .fig2-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule-strong);
    font-family: var(--font-mono);
  }

  .fig2-strip-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .fig-id {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--signal-ink);
  }

  .fig-title {
    font-size: 0.82rem;
    color: var(--ink);
  }

  .fig-spec {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .fig2-box {
    position: relative;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
  }

  .fig2-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
  }

  /* Crop marks at frame corners */
  .crop-mark {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1;
    color: var(--ink-3);
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }
  .crop-mark.top-left { top: -8px; left: -6px; }
  .crop-mark.top-right { top: -8px; right: -6px; }
  .crop-mark.bottom-left { bottom: -8px; left: -6px; }
  .crop-mark.bottom-right { bottom: -8px; right: -6px; }

  /* Left Column: Schematic */
  .fig2-schematic {
    padding: clamp(1.5rem, 1.25rem + 1.2vw, 2.5rem);
    border-right: 1px solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .plane-card {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
  }

  .plane-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
  }

  .plane-id-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .plane-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--signal-ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 1px 5px;
    border-radius: 2px;
  }

  .plane-badge.is-data {
    color: var(--ink);
  }

  .plane-type {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .plane-port-tag {
    font-size: 0.7rem;
    padding: 1px 6px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper);
    color: var(--ink);
  }

  .plane-port-tag.is-signal {
    border-color: rgba(255, 77, 23, 0.4);
    color: var(--signal-ink);
  }

  .plane-route {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 6px 10px;
    margin-bottom: var(--space-3);
    white-space: nowrap;
    overflow-x: auto;
  }

  .route-host {
    font-weight: 600;
    color: var(--ink);
  }

  .route-arrow {
    color: var(--signal);
    font-size: 0.75rem;
  }

  .route-dest {
    color: var(--signal-ink);
    font-weight: 500;
  }

  .plane-desc {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-2);
    margin-bottom: var(--space-4);
  }

  .plane-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip-item {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 2px 7px;
  }

  .plane-divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block: var(--space-1);
    font-family: var(--font-mono);
  }

  .div-line {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .div-label {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* Right Column: Mini Ingress YAML Viewer */
  .fig2-code-col {
    padding: clamp(1.5rem, 1.25rem + 1.2vw, 2.5rem);
    display: flex;
    flex-direction: column;
    background: var(--paper);
  }

  .yaml-viewer {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .yaml-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--paper-3);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .yaml-file-info {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-weight: 500;
  }

  .yaml-glyph {
    color: var(--ink-3);
  }

  .yaml-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .yaml-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
  }

  .yaml-code-wrap {
    padding: var(--space-4);
    background: var(--paper);
    flex: 1;
    overflow-x: auto;
  }

  .yaml-pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--ink);
  }

  .yaml-k {
    color: var(--ink);
    font-weight: 600;
  }

  .yaml-s {
    color: var(--ok);
  }

  .yaml-highlight {
    display: block;
    background: var(--signal-soft);
    border-left: 3px solid var(--signal);
    margin-left: -1rem;
    margin-right: -1rem;
    padding-left: calc(1rem - 3px);
    padding-right: 1rem;
    border-radius: 0;
    color: inherit;
  }

  .yaml-tag {
    display: inline-block;
    margin-left: 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--signal-ink);
    letter-spacing: 0.05em;
  }

  .yaml-footer {
    padding: var(--space-4);
    background: var(--paper-2);
    border-top: 1px solid var(--rule);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .yaml-footer-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
    font-family: var(--font-mono);
  }

  .signal-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
  }

  .yaml-footer-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--signal-ink);
    text-transform: uppercase;
  }

  .yaml-footer-text {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.88rem;
  }

  .yaml-footer-text code {
    background: var(--paper);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
    font-size: 0.88em;
  }

  /* ==========================================================================
     Responsive Adjustments
     ========================================================================== */

  @media (max-width: 960px) {
    .fig2-grid {
      grid-template-columns: 1fr;
    }
    .fig2-schematic {
      border-right: none;
      border-bottom: 1px solid var(--rule-strong);
    }
  }

  @media (max-width: 820px) {
    .connector-track {
      display: none;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .step-item {
      padding: var(--space-5);
    }

    .fig2-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }

  @media (max-width: 480px) {
    .fig2-schematic,
    .fig2-code-col {
      padding: var(--space-4);
    }

    .yaml-pre {
      font-size: 0.8rem;
    }

    .plane-chips {
      gap: 4px;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .connector-draw {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    .connector-tracer {
      display: none;
    }
  }
</style>

<script>
  // How It Works section: self-drawing connector line on scroll
  (() => {
    const section = document.getElementById('how');
    if (!section) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const path = section.querySelector<SVGPathElement>('#how-step-line');
    const tracerDot = section.querySelector<SVGCircleElement>('#how-step-dot');
    const stepsWrapper = section.querySelector<HTMLElement>('.steps-wrapper');

    if (!path || !stepsWrapper) return;

    if (prefersReducedMotion) {
      path.style.strokeDashoffset = '0';
      if (tracerDot) tracerDot.style.display = 'none';
      return;
    }

    const totalLength = path.getTotalLength() || 760;
    path.style.strokeDasharray = `${totalLength}`;
    path.style.strokeDashoffset = `${totalLength}`;

    let isVisible = false;

    const updateConnector = () => {
      if (!isVisible || document.hidden) return;

      const rect = stepsWrapper.getBoundingClientRect();
      const winHeight = window.innerHeight;

      // Start drawing when wrapper top hits 85% of viewport, finish at 35%
      const triggerStart = winHeight * 0.85;
      const triggerEnd = winHeight * 0.35;
      const rawProgress = (triggerStart - rect.top) / (triggerStart - triggerEnd);
      const progress = Math.max(0, Math.min(1, rawProgress));

      const currentOffset = totalLength * (1 - progress);
      path.style.strokeDashoffset = `${currentOffset}`;

      if (tracerDot) {
        try {
          const pointLength = totalLength * progress;
          const pt = path.getPointAtLength(pointLength);
          tracerDot.setAttribute('cx', `${pt.x}`);
          tracerDot.setAttribute('cy', `${pt.y}`);
          tracerDot.style.opacity = progress > 0.02 ? '1' : '0';
        } catch {
          // fallback if getPointAtLength fails
        }
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            updateConnector();
          }
        });
      },
      { threshold: 0.05 }
    );

    io.observe(stepsWrapper);

    window.addEventListener('scroll', updateConnector, { passive: true });
    window.addEventListener('resize', updateConnector, { passive: true });
    updateConnector();
  })();
</script>
