  }

  .taskbar-btn.is-active .app-led,
  .taskbar-btn.is-running .app-led {
    opacity: 1;
    background: var(--ok-night);
  }

  .taskbar-tunnel {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
