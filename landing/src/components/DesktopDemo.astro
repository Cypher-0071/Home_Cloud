    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--night-text-2);
    letter-spacing: 0.1em;
  }

  .caption-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
