    color: var(--night-text-2);
    opacity: 0.45;
    pointer-events: none;
    user-select: none;
    z-index: 10;
  }
  .crop-tl { top: -14px; left: -14px; }
  .crop-tr { top: -14px; right: -14px; }
  .crop-bl { bottom: -14px; left: -14px; }
  .crop-br { bottom: -14px; right: -14px; }

  .desktop-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 580px;
    max-height: 740px;
    background: var(--night);
    border: 1px solid var(--night-rule);
    border-radius: var(--radius-lg);
    box-shadow: 0 32px 80px -24px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(255 255 255 / 0.04) inset;
    overflow: hidden;
    user-select: none;
  }

  /* Dotted grid background & watermark */
  .desktop-bg {
    position: absolute;
    inset: 0;
    bottom: 44px;
    background-image: radial-gradient(circle, rgb(241 237 228 / 0.08) 1px, transparent 1px);
