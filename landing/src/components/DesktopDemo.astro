  /* --------------------------------------------------------------------------
     Desktop Frame Container & Crop Marks
     -------------------------------------------------------------------------- */
  .desktop-frame-wrapper {
    position: relative;
    width: 100%;
    margin-inline: auto;
  }

  .crop-mark {
