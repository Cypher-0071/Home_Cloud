---
// DesktopDemo.astro — §01 Live Desktop Demo
// Fully interactive fake web desktop: draggable windows, live sparklines,
// auto-typing terminal with CPU spike trigger, files upload, docker toggles,
// taskbar with live clock and tunnel status, and mobile tabbed fallback.
---

<section id="desktop" class="desktop-section" aria-label="Interactive desktop demo">
  <div class="container">
    <div class="demo-header reveal">
      <span class="eyebrow night-eyebrow">§ 01 — Live preview</span>
      <h2 class="display night-display">Not another dashboard. <em>A desktop.</em></h2>
      <p class="lede night-lede">
        Overlapping windows, a taskbar, a real shell. Run a build, watch the CPU climb, grab the log — side by side, from your phone if you must.
      </p>
    </div>

    <!-- Desktop Canvas Frame -->
    <div class="desktop-frame-wrapper reveal" style="--reveal-delay: 100ms;">
      <!-- Corner technical crop marks -->
      <div class="crop-mark crop-tl" aria-hidden="true">+</div>
      <div class="crop-mark crop-tr" aria-hidden="true">+</div>
      <div class="crop-mark crop-bl" aria-hidden="true">+</div>
      <div class="crop-mark crop-br" aria-hidden="true">+</div>

      <div class="desktop-frame" id="desktop-frame">
        <!-- Background dotted grid & technical watermark -->
        <div class="desktop-bg" aria-hidden="true">
          <div class="desktop-watermark">
            <svg class="watermark-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
              <circle cx="12" cy="13" r="2" fill="var(--signal)" stroke="none" />
            </svg>
            <span class="watermark-text">HOME CLOUD · HOST CONTROL PLANE · PORT 3000</span>
          </div>
        </div>

        <!-- Mobile Tab Switcher (<760px fallback) -->
        <nav class="mobile-tabs" aria-label="Mobile window tabs" role="tablist">
          <button class="mobile-tab" data-app="metrics" role="tab" aria-selected="false">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
            <span>Activity</span>
          </button>
          <button class="mobile-tab" data-app="files" role="tab" aria-selected="false">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
            </svg>
            <span>Files</span>
          </button>
          <button class="mobile-tab is-active" data-app="terminal" role="tab" aria-selected="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" />
            </svg>
            <span>Terminal</span>
          </button>
          <button class="mobile-tab" data-app="docker" role="tab" aria-selected="false">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
              <line x1="12" y1="22.08" x2="12" y2="12" />
            </svg>
            <span>Docker</span>
          </button>
        </nav>

        <!-- WINDOW 1: TERMINAL -->
        <article
          class="os-window is-focused"
          id="win-terminal"
          data-app="terminal"
          style="left: 24px; top: 22px; width: 490px; height: 330px; z-index: 15;"
          aria-label="Terminal window"
        >
          <header class="win-titlebar" data-drag-handle="terminal">
            <div class="win-title">
              <svg class="win-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" />
              </svg>
              <span>Terminal — rudra@closet: ~</span>
            </div>
            <div class="win-controls">
              <button class="win-btn win-btn-minimize" data-action="minimize" aria-label="Minimize Terminal">
                <svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
              <button class="win-btn win-btn-close" data-action="close" aria-label="Close Terminal">
                <svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3l-10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
            </div>
          </header>
          <div class="win-body terminal-body" id="term-body" tabindex="0" role="region" aria-label="Terminal session">
            <div class="terminal-content" id="term-content">
              <!-- Content rendered dynamically by script -->
            </div>
          </div>
        </article>

        <!-- WINDOW 2: ACTIVITY MONITOR -->
        <article
          class="os-window"
          id="win-metrics"
          data-app="metrics"
          style="left: 530px; top: 22px; width: 510px; height: 350px; z-index: 12;"
          aria-label="Activity Monitor window"
        >
          <header class="win-titlebar" data-drag-handle="metrics">
            <div class="win-title">
              <svg class="win-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
              </svg>
              <span>Activity Monitor — closet.lan</span>
            </div>
            <div class="win-controls">
              <button class="win-btn win-btn-minimize" data-action="minimize" aria-label="Minimize Activity Monitor">
                <svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
              <button class="win-btn win-btn-close" data-action="close" aria-label="Close Activity Monitor">
                <svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3l-10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
            </div>
          </header>
          <div class="win-body metrics-body">
            <div class="metrics-topbar">
              <div class="metrics-meta">
                <span class="meta-dot"></span>
                <span>SYSTEM TELEMETRY · 8 CORES · LINUX 6.8</span>
              </div>
              <div class="sse-badge">
                <span class="sse-led"></span>
                <span>SSE / 2s</span>
              </div>
            </div>

            <div class="metrics-grid">
              <!-- Row 1: CPU -->
              <div class="metric-card" id="metric-card-cpu">
                <div class="metric-header">
                  <span class="metric-name">CPU LOAD</span>
                  <div class="metric-val-wrap">
                    <span class="metric-val" id="metric-cpu-val">18.4</span>
                    <span class="metric-unit">%</span>
                  </div>
                </div>
                <div class="sparkline-container">
                  <svg class="sparkline" id="spark-cpu" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                      <linearGradient id="cpu-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="var(--signal)" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="var(--signal)" stop-opacity="0.0" />
                      </linearGradient>
                    </defs>
                    <path class="spark-fill" id="spark-cpu-fill" fill="url(#cpu-grad)" d="" />
                    <path class="spark-line spark-signal" id="spark-cpu-line" d="" />
                  </svg>
                </div>
                <div class="metric-meter">
                  <div class="meter-bar meter-cpu" id="meter-cpu-bar" style="width: 18.4%;"></div>
                </div>
                <div class="metric-subtext">Base 2.4 GHz · Turbo 4.8 GHz</div>
              </div>

              <!-- Row 2: MEMORY -->
              <div class="metric-card">
                <div class="metric-header">
                  <span class="metric-name">MEMORY</span>
                  <div class="metric-val-wrap">
                    <span class="metric-val" id="metric-mem-val">5.8</span>
                    <span class="metric-unit">/ 32 GB</span>
                  </div>
                </div>
                <div class="sparkline-container">
                  <svg class="sparkline" id="spark-mem" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                      <linearGradient id="mem-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="var(--night-text-2)" stop-opacity="0.22" />
                        <stop offset="100%" stop-color="var(--night-text-2)" stop-opacity="0.0" />
                      </linearGradient>
                    </defs>
                    <path class="spark-fill" id="spark-mem-fill" fill="url(#mem-grad)" d="" />
                    <path class="spark-line" id="spark-mem-line" d="" />
                  </svg>
                </div>
                <div class="metric-meter">
                  <div class="meter-bar" id="meter-mem-bar" style="width: 18.1%;"></div>
                </div>
                <div class="metric-subtext">DDR4 ECC · Cache: 4.2 GB</div>
              </div>

              <!-- Row 3: DISK -->
              <div class="metric-card">
                <div class="metric-header">
                  <span class="metric-name">NVMe POOL</span>
                  <div class="metric-val-wrap">
                    <span class="metric-val" id="metric-disk-val">342</span>
                    <span class="metric-unit">/ 1.8 TB</span>
                  </div>
                </div>
                <div class="sparkline-container">
                  <svg class="sparkline" id="spark-disk" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                      <linearGradient id="disk-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="var(--night-text-2)" stop-opacity="0.2" />
                        <stop offset="100%" stop-color="var(--night-text-2)" stop-opacity="0.0" />
                      </linearGradient>
                    </defs>
                    <path class="spark-fill" id="spark-disk-fill" fill="url(#disk-grad)" d="" />
                    <path class="spark-line" id="spark-disk-line" d="" />
                  </svg>
                </div>
                <div class="metric-meter">
                  <div class="meter-bar" style="width: 19%;"></div>
                </div>
                <div class="metric-subtext">btrfs mirror · I/O: 14.8 MB/s</div>
              </div>

              <!-- Row 4: NETWORK -->
              <div class="metric-card">
                <div class="metric-header">
                  <span class="metric-name">NETWORK</span>
                  <div class="metric-val-wrap">
                    <span class="metric-val" id="metric-net-val">4.2</span>
                    <span class="metric-unit">MB/s</span>
                  </div>
                </div>
                <div class="sparkline-container">
                  <svg class="sparkline" id="spark-net" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                      <linearGradient id="net-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="var(--night-text-2)" stop-opacity="0.2" />
                        <stop offset="100%" stop-color="var(--night-text-2)" stop-opacity="0.0" />
                      </linearGradient>
                    </defs>
                    <path class="spark-fill" id="spark-net-fill" fill="url(#net-grad)" d="" />
                    <path class="spark-line" id="spark-net-line" d="" />
                  </svg>
                </div>
                <div class="metric-meter">
                  <div class="meter-bar" id="meter-net-bar" style="width: 28%;"></div>
                </div>
                <div class="metric-subtext">↓ 4.2 MB/s · ↑ 1.1 MB/s (eth0)</div>
              </div>
            </div>
          </div>
        </article>

        <!-- WINDOW 3: DOCKER MANAGER -->
        <article
          class="os-window"
          id="win-docker"
          data-app="docker"
          style="left: 280px; top: 190px; width: 520px; height: 320px; z-index: 11;"
          aria-label="Docker Manager window"
        >
          <header class="win-titlebar" data-drag-handle="docker">
            <div class="win-title">
              <svg class="win-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                <line x1="12" y1="22.08" x2="12" y2="12" />
              </svg>
              <span>Docker Manager — 4 Containers</span>
            </div>
            <div class="win-controls">
              <button class="win-btn win-btn-minimize" data-action="minimize" aria-label="Minimize Docker Manager">
                <svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
              <button class="win-btn win-btn-close" data-action="close" aria-label="Close Docker Manager">
                <svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3l-10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
            </div>
          </header>
          <div class="win-body docker-body">
            <div class="docker-toolbar">
              <span class="docker-engine-tag">DOCKER ENGINE 26.1.1 · COMPOSE v2.27</span>
              <span class="docker-summary" id="docker-summary-text">4 RUNNING · 0 STOPPED</span>
            </div>

            <div class="docker-list" role="list">
              <!-- Container 1: jellyfin -->
              <div class="docker-row" data-container="jellyfin" data-status="running" role="listitem">
                <div class="docker-main">
                  <div class="docker-name-line">
                    <span class="status-led led-running" aria-label="Running"></span>
                    <span class="docker-name">jellyfin</span>
                    <span class="subdomain-chip">jellyfin.you.dev ↗</span>
                  </div>
                  <div class="docker-meta">
                    <code>jellyfin/jellyfin:latest</code> · <span>:8096</span> · <span class="status-text">Up 6 days</span>
                  </div>
                </div>
                <div class="docker-actions">
                  <button class="docker-toggle-btn btn-stop" data-action="toggle-docker" data-target="jellyfin" aria-label="Stop jellyfin">
                    Stop
                  </button>
                </div>
              </div>

              <!-- Container 2: immich -->
              <div class="docker-row" data-container="immich" data-status="running" role="listitem">
                <div class="docker-main">
                  <div class="docker-name-line">
                    <span class="status-led led-running" aria-label="Running"></span>
                    <span class="docker-name">immich</span>
                    <span class="subdomain-chip">photos.you.dev ↗</span>
                  </div>
                  <div class="docker-meta">
                    <code>ghcr.io/immich-app:release</code> · <span>:2283</span> · <span class="status-text">Up 6 days</span>
                  </div>
                </div>
                <div class="docker-actions">
                  <button class="docker-toggle-btn btn-stop" data-action="toggle-docker" data-target="immich" aria-label="Stop immich">
                    Stop
                  </button>
                </div>
              </div>

              <!-- Container 3: vaultwarden -->
              <div class="docker-row" data-container="vaultwarden" data-status="running" role="listitem">
                <div class="docker-main">
                  <div class="docker-name-line">
                    <span class="status-led led-running" aria-label="Running"></span>
                    <span class="docker-name">vaultwarden</span>
                    <span class="subdomain-chip">pass.you.dev ↗</span>
                  </div>
                  <div class="docker-meta">
                    <code>vaultwarden/server:alpine</code> · <span>:8080</span> · <span class="status-text">Up 12 days</span>
                  </div>
                </div>
                <div class="docker-actions">
                  <button class="docker-toggle-btn btn-stop" data-action="toggle-docker" data-target="vaultwarden" aria-label="Stop vaultwarden">
                    Stop
                  </button>
                </div>
              </div>

              <!-- Container 4: pihole -->
              <div class="docker-row" data-container="pihole" data-status="running" role="listitem">
                <div class="docker-main">
                  <div class="docker-name-line">
                    <span class="status-led led-running" aria-label="Running"></span>
                    <span class="docker-name">pihole</span>
                    <span class="subdomain-chip">dns.you.dev ↗</span>
                  </div>
                  <div class="docker-meta">
                    <code>pihole/pihole:latest</code> · <span>:53, :80</span> · <span class="status-text">Up 18 days</span>
                  </div>
                </div>
                <div class="docker-actions">
                  <button class="docker-toggle-btn btn-stop" data-action="toggle-docker" data-target="pihole" aria-label="Stop pihole">
                    Stop
                  </button>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- WINDOW 4: FILE EXPLORER -->
        <article
          class="os-window"
          id="win-files"
          data-app="files"
          style="left: 70px; top: 150px; width: 480px; height: 300px; z-index: 10;"
          aria-label="File Explorer window"
        >
          <header class="win-titlebar" data-drag-handle="files">
            <div class="win-title">
              <svg class="win-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
              </svg>
              <span>File Explorer — ~/media/films</span>
            </div>
            <div class="win-controls">
              <button class="win-btn win-btn-minimize" data-action="minimize" aria-label="Minimize File Explorer">
                <svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
              <button class="win-btn win-btn-close" data-action="close" aria-label="Close File Explorer">
                <svg width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3l-10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
            </div>
          </header>
          <div class="win-body files-body">
            <div class="files-toolbar">
              <div class="files-breadcrumb">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                </svg>
                <span class="crumb">~</span>
                <span class="crumb-sep">/</span>
                <span class="crumb">media</span>
                <span class="crumb-sep">/</span>
                <span class="crumb crumb-active">films</span>
              </div>
              <div class="files-toolbar-actions">
                <button class="files-upload-btn" id="files-upload-btn" aria-label="Upload a file">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" />
                    <line x1="12" y1="3" x2="12" y2="15" />
                  </svg>
                  <span>Upload</span>
                </button>
              </div>
            </div>

            <div class="files-list" id="files-list" role="table" aria-label="Files list">
              <div class="files-header-row" role="row">
                <span class="col-name" role="columnheader">Name</span>
                <span class="col-size" role="columnheader">Size</span>
                <span class="col-date" role="columnheader">Modified</span>
              </div>

              <!-- Uploading progress placeholder row (hidden initially) -->
              <div class="file-row file-uploading-row" id="upload-progress-row" style="display: none;" role="row">
                <div class="col-name" role="cell">
                  <svg class="file-icon spin-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="12" y1="2" x2="12" y2="6" /><line x1="12" y1="18" x2="12" y2="22" />
                    <line x1="4.93" y1="4.93" x2="7.76" y2="7.76" /><line x1="16.24" y1="16.24" x2="19.07" y2="19.07" />
                    <line x1="2" y1="12" x2="6" y2="12" /><line x1="18" y1="12" x2="22" y2="12" />
                  </svg>
                  <div class="upload-filename-wrap">
                    <span class="file-name-text">documentary_archive.tar.gz</span>
                    <div class="upload-bar-track">
                      <div class="upload-bar-fill" id="upload-bar-fill" style="width: 0%;"></div>
                    </div>
                  </div>
                </div>
                <div class="col-size" id="upload-size-text" role="cell">0 / 482 MB</div>
                <div class="col-date" id="upload-status-text" role="cell">Uploading...</div>
              </div>

              <!-- Static rows -->
              <div class="file-row" role="row">
                <div class="col-name" role="cell">
                  <svg class="file-icon icon-folder" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                  </svg>
                  <span>interstellar_2014/</span>
                </div>
                <div class="col-size" role="cell">4 items</div>
                <div class="col-date" role="cell">2 days ago</div>
              </div>

              <div class="file-row" role="row">
                <div class="col-name" role="cell">
                  <svg class="file-icon icon-folder" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                  </svg>
                  <span>blade_runner_2049/</span>
                </div>
                <div class="col-size" role="cell">2 items</div>
                <div class="col-date" role="cell">5 days ago</div>
              </div>

              <div class="file-row" role="row">
                <div class="col-name" role="cell">
                  <svg class="file-icon icon-folder" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                  </svg>
                  <span>dune_part_two_2024/</span>
                </div>
