  }

  /* --------------------------------------------------------------------------
     Responsive Rules (<760px Mobile Fallback)
     -------------------------------------------------------------------------- */
  @media (max-width: 760px) {
    .desktop-frame {
      aspect-ratio: auto;
      height: 540px;
      min-height: 500px;
    }

    .crop-mark {
      display: none;
    }

    .desktop-bg {
      display: none;
    }

    /* Show mobile tab switcher */
    .mobile-tabs {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 38px;
      background: var(--night-3);
      border-bottom: 1px solid var(--night-rule);
      display: flex;
      align-items: stretch;
      z-index: 80;
    }

    .mobile-tab {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 550;
      color: var(--night-text-2);
      border-bottom: 2px solid transparent;
      transition: color var(--dur-fast), border-color var(--dur-fast);
    }

    .mobile-tab.is-active {
      color: var(--night-text);
      border-bottom-color: var(--signal);
      background: rgb(255 255 255 / 0.03);
    }

    /* Windows fill frame full-screen on mobile */
    .os-window {
      position: absolute !important;
      left: 0 !important;
      right: 0 !important;
      top: 38px !important;
      bottom: 44px !important;
      width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
      transform: none !important;
      border-radius: 0 !important;
      border-inline: none !important;
      border-top: none !important;
      display: none;
    }

    .os-window.is-active-mobile {
      display: flex;
      z-index: 70 !important;
    }

    .win-controls {
      display: none;
    }

    .win-titlebar {
      cursor: default;
    }

    .metrics-grid {
      grid-template-columns: 1fr;
    }

    .brand-text {
      display: none;
    }

    .taskbar-apps {
      gap: 2px;
    }

    .taskbar-btn span:not(.app-led) {
      display: none;
    }

    .demo-captions {
      flex-direction: column;
      gap: var(--space-2);
      text-align: center;
    }

    .caption-bullet {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .os-window {
      transition: none !important;
    }
    :global(.term-cursor) {
      animation: none !important;
      opacity: 1 !important;
    }
    .tunnel-led,
    .sse-led {
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  // --------------------------------------------------------------------------
  // Desktop Interaction Engine
  // --------------------------------------------------------------------------

  interface WindowData {
    id: string;
    el: HTMLElement;
    isMinimized: boolean;
    isClosed: boolean;
    x: number;
    y: number;
  }

  const frame = document.getElementById('desktop-frame') as HTMLElement | null;
  const windows: Record<string, WindowData> = {};
  let highestZ = 20;
  let activeAppId = 'terminal';
  let isMobileMode = window.innerWidth <= 760;

  // Reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Liveness flag for IntersectionObserver & document.visibilityState
  let isVisibleOnScreen = true;

  // Initialize Windows
  const windowEls = document.querySelectorAll<HTMLElement>('.os-window');
  windowEls.forEach((el) => {
    const id = el.dataset.app || '';
    if (!id) return;

    windows[id] = {
      id,
      el,
      isMinimized: false,
      isClosed: false,
      x: parseFloat(el.style.left) || 20,
      y: parseFloat(el.style.top) || 20,
    };

    // Bring to front on click
    el.addEventListener('pointerdown', () => {
      focusWindow(id);
    });
  });

  function focusWindow(id: string) {
    activeAppId = id;
    highestZ += 1;

    // Update active styles on windows
    Object.values(windows).forEach((win) => {
      if (win.id === id) {
        win.el.style.zIndex = String(highestZ);
        win.el.classList.add('is-focused');
        win.el.classList.remove('is-minimized', 'is-closed');
        win.isMinimized = false;
        win.isClosed = false;
      } else {
        win.el.classList.remove('is-focused');
      }
    });

    // Update taskbar button states
    document.querySelectorAll<HTMLElement>('.taskbar-btn').forEach((btn) => {
      const btnApp = btn.dataset.taskbarApp;
      if (btnApp === id) {
        btn.classList.add('is-active', 'is-running');
      } else {
        btn.classList.remove('is-active');
        const target = windows[btnApp || ''];
        if (target && !target.isClosed) {
          btn.classList.add('is-running');
        } else {
          btn.classList.remove('is-running');
        }
      }
    });

    // Update mobile tabs if in mobile mode
    if (isMobileMode) {
      document.querySelectorAll<HTMLElement>('.mobile-tab').forEach((tab) => {
        const tabApp = tab.dataset.app;
        if (tabApp === id) {
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
        } else {
          tab.classList.remove('is-active');
          tab.setAttribute('aria-selected', 'false');
        }
      });

      Object.values(windows).forEach((win) => {
        if (win.id === id) {
          win.el.classList.add('is-active-mobile');
        } else {
          win.el.classList.remove('is-active-mobile');
        }
      });
    }
  }

  // Window titlebar drag handling (constrained to desktop frame)
  document.querySelectorAll<HTMLElement>('[data-drag-handle]').forEach((handle) => {
    const appId = handle.dataset.dragHandle || '';
    const win = windows[appId];
    if (!win) return;

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialX = 0;
    let initialY = 0;

    handle.addEventListener('pointerdown', (e) => {
      // Ignore if clicking on control buttons
      if ((e.target as HTMLElement).closest('.win-btn')) return;
      if (isMobileMode) return;

      focusWindow(appId);
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      initialX = win.el.offsetLeft;
      initialY = win.el.offsetTop;

      win.el.classList.add('is-dragging');
      handle.setPointerCapture(e.pointerId);
    });

    handle.addEventListener('pointermove', (e) => {
      if (!isDragging || !frame) return;

      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;

      // Constrain window within desktop frame
      const frameRect = frame.getBoundingClientRect();
      const winWidth = win.el.offsetWidth;
      const winHeight = win.el.offsetHeight;
      const taskbarHeight = 44;

      const maxX = Math.max(0, frameRect.width - winWidth);
      const maxY = Math.max(0, frameRect.height - taskbarHeight - winHeight);

      const newX = Math.max(0, Math.min(maxX, initialX + deltaX));
      const newY = Math.max(0, Math.min(maxY, initialY + deltaY));

      win.x = newX;
      win.y = newY;
      win.el.style.left = `${newX}px`;
      win.el.style.top = `${newY}px`;
    });

    const stopDrag = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      win.el.classList.remove('is-dragging');
      try {
        handle.releasePointerCapture(e.pointerId);
      } catch {
        // ignore
      }
    };

    handle.addEventListener('pointerup', stopDrag);
    handle.addEventListener('pointercancel', stopDrag);
  });

  // Minimize / Close buttons
  document.querySelectorAll<HTMLElement>('.win-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const winEl = btn.closest('.os-window') as HTMLElement | null;
      if (!winEl) return;
      const appId = winEl.dataset.app || '';
      const win = windows[appId];
      if (!win) return;

      const action = btn.dataset.action;
      if (action === 'minimize') {
        win.isMinimized = true;
        win.el.classList.add('is-minimized');
        win.el.classList.remove('is-focused');

        const taskbarBtn = document.querySelector(`.taskbar-btn[data-taskbar-app="${appId}"]`);
        taskbarBtn?.classList.remove('is-active');
      } else if (action === 'close') {
        win.isClosed = true;
        win.el.classList.add('is-closed');
        win.el.classList.remove('is-focused');

        const taskbarBtn = document.querySelector(`.taskbar-btn[data-taskbar-app="${appId}"]`);
        taskbarBtn?.classList.remove('is-active', 'is-running');
      }
    });
  });

  // Taskbar button interactions (toggle minimize / restore / focus)
  document.querySelectorAll<HTMLElement>('.taskbar-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const appId = btn.dataset.taskbarApp || '';
      const win = windows[appId];
      if (!win) return;

      if (win.isClosed) {
        win.isClosed = false;
        win.isMinimized = false;
        win.el.classList.remove('is-closed', 'is-minimized');
        focusWindow(appId);
      } else if (win.isMinimized) {
        win.isMinimized = false;
        win.el.classList.remove('is-minimized');
        focusWindow(appId);
      } else if (activeAppId === appId && win.el.classList.contains('is-focused')) {
        // Active window clicked on taskbar -> minimize
        win.isMinimized = true;
        win.el.classList.add('is-minimized');
        win.el.classList.remove('is-focused');
        btn.classList.remove('is-active');
      } else {
        focusWindow(appId);
      }
    });
  });

  // Mobile Tabs switcher
  document.querySelectorAll<HTMLElement>('.mobile-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const appId = tab.dataset.app || '';
      focusWindow(appId);
    });
  });

  // Window resize observer to adapt initial layout & boundaries
  function handleResize() {
    isMobileMode = window.innerWidth <= 760;
    if (isMobileMode) {
      focusWindow(activeAppId);
    } else {
      // Remove mobile class
      Object.values(windows).forEach((win) => {
        win.el.classList.remove('is-active-mobile');
      });
      // Clamp windows if desktop resized smaller
      if (frame) {
        const frameWidth = frame.clientWidth;
        const frameHeight = frame.clientHeight;
        Object.values(windows).forEach((win) => {
          const winWidth = win.el.offsetWidth;
          const winHeight = win.el.offsetHeight;
          const maxX = Math.max(0, frameWidth - winWidth);
          const maxY = Math.max(0, frameHeight - 44 - winHeight);
          if (win.x > maxX) {
            win.x = maxX;
            win.el.style.left = `${maxX}px`;
          }
          if (win.y > maxY) {
            win.y = maxY;
            win.el.style.top = `${maxY}px`;
          }
        });
      }
    }
  }

  // Optimize initial placement based on desktop container width
  function setupInitialPositions() {
    if (!frame || window.innerWidth <= 760) return;
    const fw = frame.clientWidth;
    const fh = frame.clientHeight;

    // Terminal
    if (windows['terminal']) {
      windows['terminal'].x = 24;
      windows['terminal'].y = 20;
    }
    // Activity Monitor
    if (windows['metrics']) {
      const metricsW = Math.min(510, Math.floor(fw * 0.48));
      windows['metrics'].el.style.width = `${metricsW}px`;
      const metricsX = Math.max(260, fw - metricsW - 24);
      windows['metrics'].x = metricsX;
      windows['metrics'].y = 20;
      windows['metrics'].el.style.left = `${metricsX}px`;
      windows['metrics'].el.style.top = '20px';
    }
    // Docker Manager
    if (windows['docker']) {
      const dockerW = Math.min(520, Math.floor(fw * 0.5));
      windows['docker'].el.style.width = `${dockerW}px`;
      const dockerX = Math.max(20, Math.floor((fw - dockerW) / 2) + 40);
      const dockerY = Math.min(220, Math.max(160, fh - 320 - 54));
      windows['docker'].x = dockerX;
      windows['docker'].y = dockerY;
      windows['docker'].el.style.left = `${dockerX}px`;
      windows['docker'].el.style.top = `${dockerY}px`;
    }
    // Files
    if (windows['files']) {
      const filesW = Math.min(480, Math.floor(fw * 0.46));
      windows['files'].el.style.width = `${filesW}px`;
      windows['files'].x = 60;
      windows['files'].y = 150;
      windows['files'].el.style.left = '60px';
      windows['files'].el.style.top = '150px';
    }
  }

  setupInitialPositions();
  window.addEventListener('resize', handleResize);
  handleResize();

  // Initial focus on Terminal
  focusWindow('terminal');

  // --------------------------------------------------------------------------
  // Live Clock
  // --------------------------------------------------------------------------
  const clockEl = document.getElementById('taskbar-clock');
  function updateClock() {
    if (!clockEl) return;
    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    const s = String(now.getSeconds()).padStart(2, '0');
    clockEl.textContent = `${h}:${m}:${s}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // --------------------------------------------------------------------------
  // Terminal Script & CPU Spike Trigger
  // --------------------------------------------------------------------------
  const termContent = document.getElementById('term-content');
  const termBody = document.getElementById('term-body');
  let cpuSpikeActive = false;

  const terminalScript = [
    { type: 'cmd', text: 'uptime' },
    { type: 'out', text: ' 22:41:07 up 41 days,  3:12,  1 user,  load average: 0.42, 0.38, 0.31' },
    { type: 'cmd', text: "docker ps --format '{{.Names}}\t{{.Status}}'" },
    { type: 'out', text: 'jellyfin      Up 6 days\nimmich        Up 6 days\nvaultwarden   Up 12 days' },
    { type: 'cmd', text: 'pnpm build', spike: true },
    { type: 'out', text: '✓ built in 4.81s', isSuccess: true },
  ];

  function renderTerminalStatic() {
    if (!termContent) return;
    let html = '';
    terminalScript.forEach((step) => {
      if (step.type === 'cmd') {
        html += `<div class="term-line"><span class="term-user">rudra@closet</span>:<span class="term-path">~</span><span class="term-dollar">$</span> <span class="term-cmd">${step.text}</span></div>`;
      } else if (step.type === 'out') {
        const cls = step.isSuccess ? 'term-out term-success' : 'term-out';
        html += `<div class="${cls}">${step.text}</div>`;
      }
    });
    html += `<div class="term-line"><span class="term-user">rudra@closet</span>:<span class="term-path">~</span><span class="term-dollar">$</span> <span class="term-cursor"></span></div>`;
    termContent.innerHTML = html;
  }

  let scriptIndex = 0;
  let charIndex = 0;
  let currentHtml = '';
  let typingTimer: number | null = null;

  function runTypingLoop() {
    if (prefersReducedMotion) {
      renderTerminalStatic();
      return;
    }

    if (!isVisibleOnScreen || document.hidden) {
      typingTimer = window.setTimeout(runTypingLoop, 1000);
      return;
    }

    if (!termContent) return;

    if (scriptIndex >= terminalScript.length) {
      // Loop finished: show prompt with blinking cursor, wait 6.5s then loop
      termContent.innerHTML = currentHtml + `<div class="term-line"><span class="term-user">rudra@closet</span>:<span class="term-path">~</span><span class="term-dollar">$</span> <span class="term-cursor"></span></div>`;
      if (termBody) termBody.scrollTop = termBody.scrollHeight;
      typingTimer = window.setTimeout(() => {
        scriptIndex = 0;
        charIndex = 0;
        currentHtml = '';
        runTypingLoop();
      }, 6500);
      return;
    }

    const currentItem = terminalScript[scriptIndex];

    if (currentItem.type === 'cmd') {
      const promptHtml = `<div class="term-line"><span class="term-user">rudra@closet</span>:<span class="term-path">~</span><span class="term-dollar">$</span> <span class="term-cmd">`;
      if (charIndex < currentItem.text.length) {
        charIndex++;
        const typed = currentItem.text.slice(0, charIndex);
        termContent.innerHTML = currentHtml + promptHtml + typed + `</span><span class="term-cursor"></span></div>`;
        if (termBody) termBody.scrollTop = termBody.scrollHeight;
        const delay = 32 + Math.random() * 45;
        typingTimer = window.setTimeout(runTypingLoop, delay);
      } else {
        // Finished typing command
        currentHtml += promptHtml + currentItem.text + `</span></div>`;
        termContent.innerHTML = currentHtml;
        charIndex = 0;
        scriptIndex++;

        // Trigger CPU spike in Activity Monitor!
        if (currentItem.spike) {
          triggerCpuSpike();
        }

        typingTimer = window.setTimeout(runTypingLoop, 380);
      }
    } else if (currentItem.type === 'out') {
      const cls = currentItem.isSuccess ? 'term-out term-success' : 'term-out';
      currentHtml += `<div class="${cls}">${currentItem.text}</div>`;
      termContent.innerHTML = currentHtml;
      if (termBody) termBody.scrollTop = termBody.scrollHeight;
      scriptIndex++;
      typingTimer = window.setTimeout(runTypingLoop, 450);
    }
  }

  function triggerCpuSpike() {
    cpuSpikeActive = true;
    const cpuCard = document.getElementById('metric-card-cpu');
    cpuCard?.classList.add('is-spiking');

    // Cool down after 4.5 seconds
    window.setTimeout(() => {
      cpuSpikeActive = false;
      cpuCard?.classList.remove('is-spiking');
    }, 4500);
  }

  // --------------------------------------------------------------------------
  // Activity Monitor: Live Sparklines & Telemetry
  // --------------------------------------------------------------------------
  const SPARK_POINTS = 20;

  // History buffers
  const cpuHistory: number[] = Array.from({ length: SPARK_POINTS }, () => 14 + Math.random() * 8);
  const memHistory: number[] = Array.from({ length: SPARK_POINTS }, () => 18 + Math.random() * 0.4);
  const diskHistory: number[] = Array.from({ length: SPARK_POINTS }, () => 19 + Math.random() * 0.3);
  const netHistory: number[] = Array.from({ length: SPARK_POINTS }, () => 20 + Math.random() * 15);

  function pointsToSvgPath(points: number[], maxVal = 100): { linePath: string; fillPath: string } {
    const width = 100;
    const height = 28;
    const stepX = width / (points.length - 1);

    const coords = points.map((p, idx) => {
      const x = (idx * stepX).toFixed(1);
      const normalized = Math.min(100, Math.max(0, p)) / maxVal;
      const y = (height - normalized * (height - 4) - 2).toFixed(1);
      return `${x},${y}`;
    });

    const linePath = 'M ' + coords.join(' L ');
    const fillPath = `M ${coords[0]} L ` + coords.join(' L ') + ` L 100,28 L 0,28 Z`;

    return { linePath, fillPath };
  }

  function renderSparklines() {
    // CPU
    const cpuPaths = pointsToSvgPath(cpuHistory, 100);
    const cpuLine = document.getElementById('spark-cpu-line');
    const cpuFill = document.getElementById('spark-cpu-fill');
    if (cpuLine) cpuLine.setAttribute('d', cpuPaths.linePath);
    if (cpuFill) cpuFill.setAttribute('d', cpuPaths.fillPath);

    // Memory
    const memPaths = pointsToSvgPath(memHistory, 100);
    const memLine = document.getElementById('spark-mem-line');
    const memFill = document.getElementById('spark-mem-fill');
    if (memLine) memLine.setAttribute('d', memPaths.linePath);
    if (memFill) memFill.setAttribute('d', memPaths.fillPath);

    // Disk
    const diskPaths = pointsToSvgPath(diskHistory, 100);
    const diskLine = document.getElementById('spark-disk-line');
    const diskFill = document.getElementById('spark-disk-fill');
    if (diskLine) diskLine.setAttribute('d', diskPaths.linePath);
    if (diskFill) diskFill.setAttribute('d', diskPaths.fillPath);

    // Network
    const netPaths = pointsToSvgPath(netHistory, 100);
    const netLine = document.getElementById('spark-net-line');
    const netFill = document.getElementById('spark-net-fill');
    if (netLine) netLine.setAttribute('d', netPaths.linePath);
    if (netFill) netFill.setAttribute('d', netPaths.fillPath);
  }

  function updateMetricsData() {
    if (!isVisibleOnScreen || document.hidden) return;

    // CPU calculation
    let newCpu: number;
    if (cpuSpikeActive) {
      newCpu = 88.5 + Math.random() * 5.5; // Spike to ~94%
    } else {
      newCpu = 15.2 + Math.random() * 7.4; // Normal 15-22%
    }
    cpuHistory.shift();
    cpuHistory.push(newCpu);

    const cpuValEl = document.getElementById('metric-cpu-val');
    const cpuBarEl = document.getElementById('meter-cpu-bar');
    if (cpuValEl) cpuValEl.textContent = newCpu.toFixed(1);
    if (cpuBarEl) cpuBarEl.style.width = `${Math.min(100, newCpu)}%`;

    // Memory calculation
    const baseMem = cpuSpikeActive ? 6.3 : 5.8;
    const newMemGB = baseMem + (Math.random() * 0.2 - 0.1);
    const memPct = (newMemGB / 32) * 100;
    memHistory.shift();
    memHistory.push(memPct);

    const memValEl = document.getElementById('metric-mem-val');
    const memBarEl = document.getElementById('meter-mem-bar');
    if (memValEl) memValEl.textContent = newMemGB.toFixed(1);
    if (memBarEl) memBarEl.style.width = `${memPct.toFixed(1)}%`;

    // Disk calculation
    const newDisk = 19 + (Math.random() * 0.4 - 0.2);
    diskHistory.shift();
    diskHistory.push(newDisk);

    // Network calculation
    const newNetRate = (cpuSpikeActive ? 8.4 : 3.8) + (Math.random() * 1.6 - 0.8);
    netHistory.shift();
    netHistory.push((newNetRate / 20) * 100);

    const netValEl = document.getElementById('metric-net-val');
    const netBarEl = document.getElementById('meter-net-bar');
    if (netValEl) netValEl.textContent = newNetRate.toFixed(1);
    if (netBarEl) netBarEl.style.width = `${Math.min(100, (newNetRate / 10) * 100).toFixed(0)}%`;

    renderSparklines();
  }

  renderSparklines();
  const metricsInterval = setInterval(updateMetricsData, 1200);

  // --------------------------------------------------------------------------
  // Docker Manager Start / Stop Toggles
  // --------------------------------------------------------------------------
  let runningCount = 4;
  const summaryEl = document.getElementById('docker-summary-text');

  function updateDockerSummary() {
    if (!summaryEl) return;
    const stoppedCount = 4 - runningCount;
    summaryEl.textContent = `${runningCount} RUNNING · ${stoppedCount} STOPPED`;
    if (runningCount === 0) {
      summaryEl.style.color = 'var(--night-text-2)';
    } else {
      summaryEl.style.color = 'var(--ok-night)';
    }
  }

  document.querySelectorAll<HTMLElement>('[data-action="toggle-docker"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const containerName = btn.dataset.target || '';
      const row = document.querySelector(`.docker-row[data-container="${containerName}"]`) as HTMLElement | null;
      if (!row) return;

      const currentStatus = row.dataset.status || 'running';
      const led = row.querySelector('.status-led');
      const statusText = row.querySelector('.status-text');

      // Show temporary spinner
      btn.innerHTML = '<span class="docker-spinner"></span>';
      btn.style.pointerEvents = 'none';

      window.setTimeout(() => {
        btn.style.pointerEvents = 'auto';

        if (currentStatus === 'running') {
          // Flip to stopped
          row.dataset.status = 'stopped';
          row.classList.add('is-stopped');
          btn.textContent = 'Start';
          btn.className = 'docker-toggle-btn btn-start';
          if (led) {
            led.className = 'status-led led-stopped';
          }
          if (statusText) {
            statusText.textContent = 'Exited (0)';
          }
          runningCount = Math.max(0, runningCount - 1);
        } else {
          // Flip to running
          row.dataset.status = 'running';
          row.classList.remove('is-stopped');
          btn.textContent = 'Stop';
          btn.className = 'docker-toggle-btn btn-stop';
          if (led) {
            led.className = 'status-led led-running';
          }
          if (statusText) {
            statusText.textContent = 'Up 1 second';
          }
          runningCount = Math.min(4, runningCount + 1);
        }
        updateDockerSummary();
      }, 420);
    });
  });

  // --------------------------------------------------------------------------
  // File Explorer Upload Progress Demo
  // --------------------------------------------------------------------------
  const uploadBtn = document.getElementById('files-upload-btn') as HTMLButtonElement | null;
  const uploadRow = document.getElementById('upload-progress-row');
  const uploadFill = document.getElementById('upload-bar-fill');
  const uploadSizeText = document.getElementById('upload-size-text');
  const uploadStatusText = document.getElementById('upload-status-text');
  let isUploading = false;

  uploadBtn?.addEventListener('click', () => {
    if (isUploading || !uploadRow || !uploadFill) return;
    isUploading = true;
    if (uploadBtn) uploadBtn.disabled = true;

    uploadRow.style.display = 'grid';
    uploadFill.style.width = '0%';
    if (uploadSizeText) uploadSizeText.textContent = '0 / 482 MB';
    if (uploadStatusText) uploadStatusText.textContent = 'Uploading...';

    let progress = 0;
    const totalSize = 482; // MB

    const uploadInterval = setInterval(() => {
      progress += 5 + Math.random() * 8;
      if (progress >= 100) {
        progress = 100;
        clearInterval(uploadInterval);

        uploadFill.style.width = '100%';
        if (uploadSizeText) uploadSizeText.textContent = '482 MB';
        if (uploadStatusText) uploadStatusText.textContent = '✓ Completed';

        window.setTimeout(() => {
          isUploading = false;
          if (uploadBtn) uploadBtn.disabled = false;
        }, 1200);
      } else {
        uploadFill.style.width = `${progress.toFixed(0)}%`;
        const currentMB = ((progress / 100) * totalSize).toFixed(0);
        if (uploadSizeText) uploadSizeText.textContent = `${currentMB} / ${totalSize} MB`;
        if (uploadStatusText) uploadStatusText.textContent = `${progress.toFixed(0)}%`;
      }
    }, 110);
  });

  // --------------------------------------------------------------------------
  // Offscreen / Hidden Visibility Pausing (IntersectionObserver)
  // --------------------------------------------------------------------------
  const desktopSection = document.getElementById('desktop');
  if (desktopSection && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisibleOnScreen = entry.isIntersecting;
        });
      },
      { threshold: 0.05 },
    );
    observer.observe(desktopSection);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      isVisibleOnScreen = false;
    } else if (desktopSection) {
      const rect = desktopSection.getBoundingClientRect();
      isVisibleOnScreen = rect.top < window.innerHeight && rect.bottom > 0;
    }
  });

  // Start Terminal Typing Loop
  runTypingLoop();
</script>
