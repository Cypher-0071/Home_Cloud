  | () () |    <span class="neofetch-field">Kernel:</span> 6.8.0-45-generic
   \\  _  /     <span class="neofetch-field">Uptime:</span> 42 days, 16 hours, 28 mins
    \`---\`      <span class="neofetch-field">Packages:</span> 942 (dpkg), 4 (docker)
   /|   |\\     <span class="neofetch-field">Memory:</span> 3.42 GiB / 15.82 GiB (21%)
  / |   | \\    <span class="neofetch-field">Disk (/):</span> 284 GiB / 1.82 TiB (15%)
 /  |===|  \\   <span class="neofetch-field">CPU Temp:</span> 37.5°C (Fan: 0 RPM)
               <span class="neofetch-field">Tunnel:</span> Active (cloud.domain.me)`,
    'docker ps': `CONTAINER ID   IMAGE                 STATUS         PORTS                     NAMES
a8f9c104e7b2   nextcloud:29-apache   Up 42 days     127.0.0.1:8080->80/tcp    nextcloud-hub
7b12d4a90fe3   plexinc/pms:latest    Up 28 days     127.0.0.1:32400->32400    plex-media
c33b8a1029df   postgres:16-alpine    Up 42 days     127.0.0.1:5432->5432      postgres-db
e4a90184cbb7   adguard/adguardhome   Up 42 days     127.0.0.1:53->53/udp      adguard-dns`,
    status: `● homecloud-daemon.service - Home Cloud Host Agent
     Loaded: loaded (/etc/systemd/system/homecloud.service; enabled)
     Active: active (running) since Thu 2026-08-26 04:12:08 UTC; 42 days ago
   Tunnel: cloudflared quic-muxed (tunnel ID: 8bf24-a72c, latency: 18ms)
   Firewall: UFW active (Incoming: DENY ALL, Outbound: ALLOW ALL)
   Open WAN Ports: 0 (Zero router ports exposed)
   Security Audit: 100% compliant (Rootless daemon, TLS 1.3 enforced)`,
    uptime: ` 20:41:00 up 42 days, 16:28,  1 user,  load average: 0.14, 0.18, 0.15`,
    help: `Available commands:
  • neofetch    - Display system hardware & OS telemetry
  • docker ps   - List active Docker containers & ports
  • status      - Show daemon health & tunnel connection
  • uptime      - System uptime and 1/5/15m load average
  • clear       - Clear terminal output window`,
  };

  function runCommand(cmd: string) {
    if (!termScreen) return;
    const cleanCmd = cmd.trim().toLowerCase();

    if (cleanCmd === 'clear') {
      termScreen.innerHTML = `
        <div class="term-line term-dim">Home Cloud Shell v1.4.0 — Screen cleared.</div>
        <div class="term-line">&nbsp;</div>
      `;
      return;
    }

    // Append command line
    const cmdLine = document.createElement('div');
    cmdLine.className = 'term-line';
    cmdLine.innerHTML = `<span class="term-prompt">user@closet-node:~$</span> <span class="term-typed">${escapeHtml(cmd)}</span>`;
    termScreen.appendChild(cmdLine);

    // Append response
    const respDiv = document.createElement('div');
    if (commandResponses[cleanCmd]) {
      respDiv.className = 'term-line';
      respDiv.innerHTML = `<pre class="neofetch-ascii" style="color: #cbd5e1; margin: 4px 0;">${commandResponses[cleanCmd]}</pre>`;
    } else {
      respDiv.className = 'term-line';
      respDiv.innerHTML = `<span style="color: #f87171;">bash: ${escapeHtml(cmd)}: command not found. Try 'help', 'status', 'docker ps', or 'neofetch'.</span>`;
    }
    termScreen.appendChild(respDiv);
    termScreen.scrollTop = termScreen.scrollHeight;
  }

  function escapeHtml(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  if (termForm && termInput) {
    termForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = termInput.value.trim();
      if (!val) return;
      runCommand(val);
      termInput.value = '';
    });
  }

  termChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const cmd = chip.getAttribute('data-cmd');
      if (cmd) runCommand(cmd);
    });
  });

  // Interactive Container Deck Toggles
  const containerToggles = document.querySelectorAll<HTMLButtonElement>('.c-toggle-btn');
  const runningBadge = document.getElementById('containers-running-count');
  const countBadge = document.getElementById('container-count-badge');

  containerToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest<HTMLElement>('.container-card');
      if (!card) return;
      const statusBadge = card.querySelector<HTMLElement>('.c-status-badge');
      const btnText = btn.querySelector<HTMLElement>('.btn-text');

      const isRunning = statusBadge?.classList.contains('is-running');
      if (isRunning) {
        // Pause container
        statusBadge?.classList.remove('is-running');
        statusBadge?.classList.add('is-paused');
        if (statusBadge) statusBadge.textContent = 'Paused';
        if (btnText) btnText.textContent = 'Resume';
      } else {
        // Resume container
        statusBadge?.classList.remove('is-paused');
        statusBadge?.classList.add('is-running');
        if (statusBadge) statusBadge.textContent = 'Running';
        if (btnText) btnText.textContent = 'Pause';
      }

      // Update counters
      const activeCount = document.querySelectorAll('.c-status-badge.is-running').length;
      if (runningBadge) runningBadge.textContent = String(activeCount);
      if (countBadge) countBadge.textContent = `${activeCount}/4`;
    });
  });
</script>
