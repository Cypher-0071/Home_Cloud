---
// landing/src/components/ProductShowcase.astro
// Interactive Product Showcase: A tactile console preview with Terminal simulator,
// Docker container switcher, live telemetry gauges, and zero-trust gateway visualizer.
---

<section id="showcase" class="showcase-section">
  <div class="container showcase-container">
    <!-- Section Header -->
    <div class="showcase-header reveal">
      <h2 class="showcase-title">
        The control plane designed for <span class="font-serif-italic">quiet reliability.</span>
      </h2>
      <p class="showcase-desc">
        Everything you need to orchestrate your home server from any web browser.
        No complicated Kubernetes YAML. No flaky SSH ports left exposed to the internet.
      </p>
    </div>

    <!-- Main Interactive Chassis -->
    <div class="console-chassis reveal">
      <!-- Hardware / Window Top Bar -->
      <div class="chassis-chrome">
        <div class="chrome-dots" aria-hidden="true">
          <span class="dot dot-close"></span>
          <span class="dot dot-min"></span>
          <span class="dot dot-expand"></span>
        </div>

        <!-- Host identity -->
        <div class="chrome-host">
          <span class="host-icon">
            <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm4 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3-7h6v-2H7v2zm0 4h6v-2H7v2zm0 4h6v-2H7v2z"/></svg>
          </span>
          <span class="host-name">closet-node-01.lan</span>
        </div>

        <!-- Interactive View Switcher Tabs -->
        <div class="chrome-tabs" role="tablist" aria-label="Console Modules">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-terminal"
            id="tab-terminal"
            class="tab-btn is-active"
            data-target="panel-terminal"
          >
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="3 5 7 8 3 11"/><line x1="9" y1="11" x2="13" y2="11"/></svg>
            <span>Terminal</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-containers"
            id="tab-containers"
            class="tab-btn"
            data-target="panel-containers"
          >
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
            <span>Containers</span>
            <span class="tab-chip" id="container-count-badge">4/4</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-telemetry"
            id="tab-telemetry"
            class="tab-btn"
            data-target="panel-telemetry"
          >
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 13h12"/><path d="M4 10v-3"/><path d="M8 10V4"/><path d="M12 10V7"/></svg>
            <span>Telemetry</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-tunnel"
            id="tab-tunnel"
            class="tab-btn"
            data-target="panel-tunnel"
          >
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="6"/><path d="M2 8h12"/><path d="M8 2a9 9 0 0 1 0 12"/></svg>
            <span>Tunnel Edge</span>
          </button>
        </div>
      </div>

      <!-- Tab Panels Container -->
      <div class="chassis-body">
        <!-- ================= PANEL 1: TERMINAL ================= -->
        <div id="panel-terminal" class="tab-panel is-active" role="tabpanel" aria-labelledby="tab-terminal">
          <div class="terminal-container">
            <!-- Command quick action chips -->
            <div class="terminal-quickbar">
              <span class="quickbar-label">Try commands:</span>
              <button type="button" class="term-chip" data-cmd="neofetch">neofetch</button>
              <button type="button" class="term-chip" data-cmd="docker ps">docker ps</button>
              <button type="button" class="term-chip" data-cmd="status">status</button>
              <button type="button" class="term-chip" data-cmd="uptime">uptime</button>
              <button type="button" class="term-chip" data-cmd="clear">clear</button>
            </div>

            <!-- Terminal output log -->
            <div class="terminal-screen" id="terminal-screen">
              <div class="term-line term-dim">Home Cloud Shell v1.4.0 (x86_64-linux-gnu) — Connected via Cloudflare Tunnel</div>
              <div class="term-line term-dim">Type or click a command chip above to execute. Type <span class="term-hl">help</span> for command list.</div>
              <div class="term-line">&nbsp;</div>
              <div class="term-line">
                <span class="term-prompt">user@closet-node:~$</span> <span class="term-typed">neofetch</span>
              </div>
              <div class="term-neofetch-output">
                <pre class="neofetch-ascii">
    .---.      <span class="neofetch-field">OS:</span> Ubuntu 24.04 LTS x86_64
   /     \     <span class="neofetch-field">Host:</span> Mini-PC N100 (4 Cores)
  | () () |    <span class="neofetch-field">Kernel:</span> 6.8.0-45-generic
   \  _  /     <span class="neofetch-field">Uptime:</span> 42 days, 16 hours, 28 mins
    `---`      <span class="neofetch-field">Packages:</span> 942 (dpkg), 4 (docker)
   /|   |\     <span class="neofetch-field">Memory:</span> 3.42 GiB / 15.82 GiB (21%)
  / |   | \    <span class="neofetch-field">Disk (/):</span> 284 GiB / 1.82 TiB (15%)
 /  |===|  \   <span class="neofetch-field">CPU Temp:</span> 37.5°C (Fan: 0 RPM)
               <span class="neofetch-field">Tunnel:</span> Active (cloud.domain.me)</pre>
              </div>
            </div>

            <!-- Interactive prompt input -->
            <form class="terminal-input-bar" id="terminal-form">
              <span class="term-prompt" aria-hidden="true">user@closet-node:~$</span>
              <input
                type="text"
                id="terminal-input"
                class="terminal-input"
                placeholder="type 'status', 'docker ps', 'neofetch'..."
                autocomplete="off"
                spellcheck="false"
              />
              <button type="submit" class="terminal-send-btn" aria-label="Send command">
                <span>Run ↵</span>
              </button>
            </form>
          </div>
        </div>

        <!-- ================= PANEL 2: CONTAINERS ================= -->
        <div id="panel-containers" class="tab-panel" role="tabpanel" aria-labelledby="tab-containers">
          <div class="containers-container">
            <div class="containers-topbar">
              <div class="containers-info">
                <span class="info-title">Docker Engine 27.2</span>
                <span class="info-sub">Bridge network `homecloud-net` · Zero external ports opened</span>
              </div>
              <div class="containers-summary-meta mono">
                <span><span id="containers-running-count">4</span> active</span>
                <span class="summary-sep">·</span>
                <span>0 exited</span>
              </div>
            </div>

            <div class="containers-grid" id="containers-grid">
              <!-- Container 1: Nextcloud -->
              <div class="container-card" data-cid="nextcloud">
                <div class="c-header">
                  <div class="c-title-group">
                    <span class="c-name">nextcloud-hub</span>
                    <span class="c-image">nextcloud:29-apache</span>
                  </div>
                  <span class="c-status-badge is-running">Running</span>
                </div>
                <div class="c-stats">
                  <div class="c-stat-row">
                    <span class="c-stat-label">CPU</span>
                    <span class="c-stat-val c-cpu">0.8%</span>
                  </div>
                  <div class="c-stat-row">
                    <span class="c-stat-label">Memory</span>
                    <span class="c-stat-val c-mem">284 MB / 2 GB</span>
                  </div>
                  <div class="c-stat-row">
                    <span class="c-stat-label">Port Binding</span>
                    <span class="c-stat-val mono">127.0.0.1:8080</span>
                  </div>
                </div>
                <div class="c-footer">
                  <span class="c-uptime">Up 42 days</span>
                  <button type="button" class="c-toggle-btn" data-action="toggle">
                    <span class="btn-text">Pause</span>
                  </button>
                </div>
              </div>

              <!-- Container 2: Plex -->
              <div class="container-card" data-cid="plex">
                <div class="c-header">
                  <div class="c-title-group">
                    <span class="c-name">plex-media</span>
                    <span class="c-image">plexinc/pms:latest</span>
                  </div>
                  <span class="c-status-badge is-running">Running</span>
                </div>
                <div class="c-stats">
                  <div class="c-stat-row">
                    <span class="c-stat-label">CPU</span>
                    <span class="c-stat-val c-cpu">1.6% (QuickSync)</span>
                  </div>
                  <div class="c-stat-row">
                    <span class="c-stat-label">Memory</span>
                    <span class="c-stat-val c-mem">512 MB / 4 GB</span>
                  </div>
                  <div class="c-stat-row">
                    <span class="c-stat-label">Port Binding</span>
                    <span class="c-stat-val mono">127.0.0.1:32400</span>
                  </div>
                </div>
                <div class="c-footer">
                  <span class="c-uptime">Up 28 days</span>
                  <button type="button" class="c-toggle-btn" data-action="toggle">
                    <span class="btn-text">Pause</span>
                  </button>
                </div>
              </div>

              <!-- Container 3: Postgres -->
              <div class="container-card" data-cid="postgres">
                <div class="c-header">
                  <div class="c-title-group">
                    <span class="c-name">postgres-db</span>
                    <span class="c-image">postgres:16-alpine</span>
                  </div>
                  <span class="c-status-badge is-running">Running</span>
                </div>
                <div class="c-stats">
                  <div class="c-stat-row">
                    <span class="c-stat-label">CPU</span>
                    <span class="c-stat-val c-cpu">0.2%</span>
                  </div>
                  <div class="c-stat-row">
                    <span class="c-stat-label">Memory</span>
                    <span class="c-stat-val c-mem">146 MB / 1 GB</span>
                  </div>
                  <div class="c-stat-row">
                    <span class="c-stat-label">Port Binding</span>
                    <span class="c-stat-val mono">127.0.0.1:5432</span>
                  </div>
                </div>
                <div class="c-footer">
                  <span class="c-uptime">Up 42 days</span>
                  <button type="button" class="c-toggle-btn" data-action="toggle">
                    <span class="btn-text">Pause</span>
                  </button>
                </div>
              </div>

              <!-- Container 4: AdGuard Home -->
              <div class="container-card" data-cid="adguard">
                <div class="c-header">
                  <div class="c-title-group">
                    <span class="c-name">adguard-dns</span>
                    <span class="c-image">adguard/adguardhome</span>
                  </div>
                  <span class="c-status-badge is-running">Running</span>
                </div>
                <div class="c-stats">
                  <div class="c-stat-row">
                    <span class="c-stat-label">CPU</span>
                    <span class="c-stat-val c-cpu">0.3%</span>
                  </div>
                  <div class="c-stat-row">
                    <span class="c-stat-label">Memory</span>
                    <span class="c-stat-val c-mem">88 MB / 512 MB</span>
                  </div>
                  <div class="c-stat-row">
                    <span class="c-stat-label">DNS Queries</span>
                    <span class="c-stat-val mono">28.4% Blocked</span>
                  </div>
                </div>
                <div class="c-footer">
                  <span class="c-uptime">Up 42 days</span>
                  <button type="button" class="c-toggle-btn" data-action="toggle">
                    <span class="btn-text">Pause</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= PANEL 3: TELEMETRY ================= -->
        <div id="panel-telemetry" class="tab-panel" role="tabpanel" aria-labelledby="tab-telemetry">
          <div class="telemetry-container">
            <div class="telem-grid">
              <!-- Metric 1: CPU -->
              <div class="telem-card">
                <div class="telem-header">
                  <span class="telem-title">Processor Load</span>
                  <span class="telem-badge" id="cpu-total-badge">14.2%</span>
                </div>
                <div class="telem-meter-bar">
                  <div class="meter-fill cpu-meter" style="width: 14.2%;"></div>
                </div>
                <div class="telem-cores-grid">
                  <div class="core-cell"><span>Core 0</span><strong>12%</strong></div>
                  <div class="core-cell"><span>Core 1</span><strong>18%</strong></div>
                  <div class="core-cell"><span>Core 2</span><strong>11%</strong></div>
                  <div class="core-cell"><span>Core 3</span><strong>15%</strong></div>
                </div>
                <div class="telem-meta-foot">
                  <span>Intel N100 4-Core @ 3.4 GHz Turbo</span>
                  <span>Governor: powersave</span>
                </div>
              </div>

              <!-- Metric 2: Memory -->
              <div class="telem-card">
                <div class="telem-header">
                  <span class="telem-title">System Memory</span>
                  <span class="telem-badge">3.4 / 16 GB (21%)</span>
                </div>
                <div class="telem-meter-bar">
                  <div class="meter-fill mem-meter" style="width: 21.5%;"></div>
                </div>
                <div class="telem-cores-grid">
                  <div class="core-cell"><span>Used</span><strong>3.42 GB</strong></div>
                  <div class="core-cell"><span>Cached</span><strong>4.81 GB</strong></div>
                  <div class="core-cell"><span>Available</span><strong>7.59 GB</strong></div>
                  <div class="core-cell"><span>Swap</span><strong>0 MB / 4G</strong></div>
                </div>
                <div class="telem-meta-foot">
                  <span>DDR5-4800 SODIMM</span>
                  <span>ZRAM enabled</span>
                </div>
              </div>

              <!-- Metric 3: NVMe Pool -->
              <div class="telem-card">
                <div class="telem-header">
                  <span class="telem-title">Storage Pool (NVMe)</span>
                  <span class="telem-badge">284 GB / 2 TB (14%)</span>
                </div>
                <div class="telem-meter-bar">
                  <div class="meter-fill disk-meter" style="width: 14.2%;"></div>
                </div>
                <div class="telem-cores-grid">
                  <div class="core-cell"><span>Read</span><strong>1.2 MB/s</strong></div>
                  <div class="core-cell"><span>Write</span><strong>4.8 MB/s</strong></div>
                  <div class="core-cell"><span>FS</span><strong>ext4</strong></div>
                  <div class="core-cell"><span>Health</span><strong class="ok">SMART OK</strong></div>
                </div>
                <div class="telem-meta-foot">
                  <span>PCIe Gen 4.0 x4</span>
                  <span>Trim scheduled daily</span>
                </div>
              </div>

              <!-- Metric 4: Acoustics & Thermals -->
              <div class="telem-card">
                <div class="telem-header">
                  <span class="telem-title">Thermals & Acoustics</span>
                  <span class="telem-badge ok">37.5°C · Silent</span>
                </div>
                <div class="telem-acoustic-display">
                  <div class="acoustic-stat">
                    <span class="big-number">0 <small>RPM</small></span>
                    <span class="sub-label">Fan Noise</span>
                  </div>
                  <div class="acoustic-stat">
                    <span class="big-number">8.4 <small>W</small></span>
                    <span class="sub-label">Wall Socket</span>
                  </div>
                  <div class="acoustic-stat">
                    <span class="big-number">42.2 <small>d</small></span>
                    <span class="sub-label">Uptime</span>
                  </div>
                </div>
                <div class="telem-meta-foot">
                  <span>Passively Cooled Chassis</span>
                  <span>Estimated power cost: ~$0.85/month</span>
                </div>
              </div>
            </div>

            <!-- Kernel Hardware Sensor Bus & Live Telemetry Deck -->
            <div class="telem-log-deck">
              <div class="telem-log-header">
                <div class="log-header-left">
                  <span class="sensor-dot"></span>
                  <span class="log-deck-title">KERNEL HARDWARE SENSOR BUS · /dev/cpu/0/msr</span>
                </div>
                <span class="log-poll-badge">POLL INTERVAL: 1000ms</span>
              </div>
              <div class="telem-log-grid">
                <div class="log-metric-pill">
                  <span class="k-label">C-STATE C10 RESIDENCE</span>
                  <strong class="k-val">94.8% (Deep Sleep Active)</strong>
                </div>
                <div class="log-metric-pill">
                  <span class="k-label">PACKAGE TDP DRAW</span>
                  <strong class="k-val">4.2 W (Package) / 8.4 W (Wall)</strong>
                </div>
                <div class="log-metric-pill">
                  <span class="k-label">ETHERNET PHY LINK</span>
                  <strong class="k-val">1000 Mbps Full-Duplex (0 Drops)</strong>
                </div>
                <div class="log-metric-pill">
                  <span class="k-label">NVMe SMART HEALTH</span>
                  <strong class="k-val ok">100% (0 Bad Blocks, 38°C)</strong>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= PANEL 4: TUNNEL ================= -->
        <div id="panel-tunnel" class="tab-panel" role="tabpanel" aria-labelledby="tab-tunnel">
          <div class="tunnel-container">
            <div class="tunnel-diagram">
              <!-- Node 1: Remote Device -->
              <div class="diagram-node">
                <div class="node-box">
                  <div class="node-icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                  </div>
                  <span class="node-title">Any Browser</span>
                  <span class="node-sub">Laptop, Phone, Tablet</span>
                </div>
                <span class="node-ip">Client anywhere on earth</span>
              </div>

              <!-- Connection 1 -->
              <div class="diagram-connector">
                <div class="connector-line">
                  <span class="packet-dot"></span>
                </div>
                <span class="connector-label">HTTPS / TLS 1.3</span>
              </div>

              <!-- Node 2: Cloudflare Edge -->
              <div class="diagram-node">
                <div class="node-box edge-box">
                  <div class="node-icon orange">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
                  </div>
                  <span class="node-title">Cloudflare Edge</span>
                  <span class="node-sub">330+ Global Data Centers</span>
                </div>
                <span class="node-ip">cloud.yourdomain.com</span>
              </div>

              <!-- Connection 2 -->
              <div class="diagram-connector">
                <div class="connector-line">
                  <span class="packet-dot reverse"></span>
                </div>
                <span class="connector-label">Outbound QUIC Tunnel</span>
              </div>

              <!-- Node 3: Home Server -->
              <div class="diagram-node">
                <div class="node-box host-box">
                  <div class="node-icon green">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                  </div>
                  <span class="node-title">Home Cloud Node</span>
                  <span class="node-sub">Behind Router & CGNAT</span>
                </div>
                <span class="node-ip">127.0.0.1:3000 (Loopback)</span>
              </div>
            </div>

            <!-- Zero Open Ports Security Card -->
            <div class="tunnel-security-card">
              <div class="security-badge-col">
                <div class="sec-stat">
                  <span class="sec-number">0</span>
                  <span class="sec-desc">Router Ports Forwarded</span>
                </div>
                <div class="sec-stat">
                  <span class="sec-number">18<small>ms</small></span>
                  <span class="sec-desc">Average Edge Latency</span>
                </div>
                <div class="sec-stat">
                  <span class="sec-number">100<small>%</small></span>
                  <span class="sec-desc">Encrypted End-to-End</span>
                </div>
              </div>
              <div class="security-text-col">
                <h4 class="sec-head">How zero-trust tunneling protects your home network</h4>
                <p class="sec-body">
                  Traditional self-hosting required punching port 80 and 443 through your home router,
                  exposing your home IP to bot scanners and script kiddies. Home Cloud establishes an <strong>outbound-only encrypted tunnel</strong> to Cloudflare's edge network.
                  Inbound traffic is authenticated before it ever touches your local machine.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase-section {
    position: relative;
    padding-block: clamp(3rem, 5vw, 6rem);
  }

  .showcase-container {
    max-width: 1140px;
    width: 100%;
    min-width: 0;
  }

  .showcase-header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }



  .showcase-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .showcase-desc {
    font-size: 1.02rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Console Hardware Frame */
  .console-chassis {
    position: relative;
    background: #0d1017;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 24px 64px -16px rgba(0, 0, 0, 0.8),
      0 8px 24px -8px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .chassis-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #11141c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    gap: 16px;
    flex-wrap: wrap;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .chrome-dots {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-close { background: #ff5f56; }
  .dot-min { background: #ffbd2e; }
  .dot-expand { background: #27c93f; }

  .chrome-host {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .host-icon {
    display: flex;
