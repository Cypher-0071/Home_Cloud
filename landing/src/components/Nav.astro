---
// landing/src/components/Nav.astro
// Desktop floating navigation: three independent capsules
// (left links / center brand / right actions). Center stays a pill and
// collapses to logo-only on scroll, with scroll progress traced around
// the pill outline. Mobile drawer preserved for a later mobile phase.
---

<header id="nav" class="nav-root">
  <div class="nav-floats">
    <!-- LEFT: section links -->
    <nav class="capsule capsule-links" aria-label="Main Navigation">
      <a href="#craft" class="nav-link">Hardware Craft</a>
      <a href="#features" class="nav-link">Features</a>
      <a href="#setup" class="nav-link">Setup</a>
    </nav>

    <!-- CENTER: brand anchor -->
    <a href="#hero" class="capsule brand-capsule" aria-label="Home Cloud — Home">
      <img
        src="/favicon.svg"
        alt=""
        width="22"
        height="22"
        class="brand-mark"
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
      <span class="brand-name">Home Cloud</span>
      <svg class="brand-progress" aria-hidden="true" focusable="false">
        <rect class="brand-progress-ring" x="1.5" y="1.5" width="61" height="41" rx="20.5" pathLength="100" />
      </svg>
    </a>

    <!-- RIGHT: actions -->
    <div class="capsule capsule-actions">
      <a
        href="https://github.com/Cypher-0071/Home_Cloud"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-gh-link"
        aria-label="View Home Cloud on GitHub"
      >
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
        <span class="gh-text">GitHub</span>
      </a>

      <a href="#setup" class="nav-install">
        <span>Install</span>
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>

      <!-- Mobile toggle (desktop hidden) -->
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer (preserved for later mobile phase) -->
  <div id="mobile-nav" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-content">
      <nav class="mobile-nav-links">
        <a href="#craft" class="mobile-link">Hardware Craft</a>
        <a href="#features" class="mobile-link">Features</a>
        <a href="#setup" class="mobile-link">Setup</a>
      </nav>
      <div class="mobile-actions">
        <a
          href="https://github.com/Cypher-0071/Home_Cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-gh-btn"
        >
          View on GitHub
        </a>
        <a href="#setup" class="mobile-install-btn">
          Install Home Cloud
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-root {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    pointer-events: none;
    padding-top: 24px;
  }

  .nav-floats {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding-inline: clamp(28px, 4vw, 52px);
  }

  /* Independent floating surfaces — precise controls, not glass */
  .capsule {
    pointer-events: auto;
    display: flex;
    align-items: center;
    background: rgba(10, 10, 10, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    box-shadow: 0 6px 20px -12px rgba(0, 0, 0, 0.5);
    transition:
      background-color 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      border-color 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      box-shadow 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      padding 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .nav-root.is-scrolled .capsule {
    background: rgba(9, 9, 9, 0.9);
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.6);
  }

  /* LEFT */
  .capsule-links {
    gap: 20px;
    padding: 0 18px;
    height: 44px;
  }

  .nav-link {
    font-family: var(--hc-font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--hc-text-secondary);
    transition: color 170ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--hc-text-primary);
  }

  /* CENTER — mathematically centered: viewport 50% minus half its own width.
     Side-group widths have zero influence on brand position, top or scrolled.
     The inter-item gap collapses with the label so the mark stays on the
     same center axis in both states (a zero-width label still consumes
     flex gap, which would offset the logo inside the capsule). */
  .brand-capsule {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    background: rgba(14, 14, 14, 0.88);
    border-color: rgba(255, 255, 255, 0.11);
    text-decoration: none;
    overflow: hidden;
    transition:
      background-color 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      border-color 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      box-shadow 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      padding 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      gap 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .brand-capsule:hover {
    border-color: rgba(255, 255, 255, 0.16);
  }

  .nav-root.is-scrolled .brand-capsule {
    gap: 0;
    padding: 0 22px;
  }

  /* Scroll-progress outline tracing the pill perimeter.
     Geometry is synced to the capsule box via ResizeObserver (see script);
     dash progress is scroll-linked with no transition — instant state, no animation. */
  .brand-progress {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    opacity: 0;
    transition: opacity 300ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .nav-root.is-scrolled .brand-progress {
    opacity: 1;
  }

  .brand-progress-ring {
    fill: none;
    stroke: rgba(255, 255, 255, 0.45);
    stroke-width: 1.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    stroke-linecap: round;
  }

  .brand-mark {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    display: block;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--hc-font-sans);
    font-size: 0.9rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: var(--hc-text-primary);
    white-space: nowrap;
    overflow: hidden;
    max-width: 140px;
    opacity: 1;
    transition:
      max-width 450ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      opacity 300ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .nav-root.is-scrolled .brand-name {
    max-width: 0;
    opacity: 0;
  }

  /* RIGHT */
  .capsule-actions {
    gap: 4px;
    height: 44px;
    padding: 4px 4px 4px 6px;
    margin-left: auto;
  }

  .nav-gh-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    color: var(--hc-text-secondary);
    font-family: var(--hc-font-sans);
    font-size: 0.83rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 170ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .nav-gh-link:hover {
    color: var(--hc-text-primary);
  }

  .nav-install {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 15px;
    border-radius: 999px;
    background: var(--hc-text-primary);
    color: #050505;
    font-family: var(--hc-font-sans);
    font-size: 0.83rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: background-color 200ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .nav-install:hover {
    background: #ffffff;
  }

  .nav-install:active {
    transform: scale(0.98);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--hc-text-primary);
    flex-shrink: 0;
  }

  .toggle-bar {
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform 170ms var(--hc-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .nav-toggle[aria-expanded='true'] .toggle-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .toggle-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile drawer — preserved, not redesigned in this phase */
  .mobile-drawer {
    display: none;
    pointer-events: auto;
    margin: 12px clamp(20px, 4vw, 32px) 0;
    background: rgba(9, 9, 9, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 24px clamp(20px, 4vw, 32px);
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.7);
  }

  .mobile-drawer.is-open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .mobile-link {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--hc-text-primary);
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-gh-btn,
  .mobile-install-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .mobile-gh-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--hc-text-primary);
  }

  .mobile-install-btn {
    background: var(--hc-text-primary);
    color: #050505;
  }

  @media (max-width: 860px) {
    .capsule-links,
    .nav-gh-link {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
    .nav-root {
      padding-top: 14px;
    }
    .nav-floats {
      padding-inline: 16px;
    }
    /* Keep brand legible on mobile — no collapse in this phase */
    .nav-root.is-scrolled .brand-name {
      max-width: 140px;
      opacity: 1;
    }
    .nav-root.is-scrolled .brand-capsule {
      padding: 0 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capsule,
    .brand-name,
    .brand-progress,
    .nav-link,
    .nav-gh-link,
    .nav-install {
      transition: none;
    }
  }
</style>

<script>
  // Scroll state: collapse center brand to logo-only pill + trace scroll
  // progress around the pill outline. No progress bar element.
  const header = document.getElementById('nav');
  const brandCapsule = header?.querySelector<HTMLElement>('.brand-capsule') ?? null;
  const progressSvg = header?.querySelector<SVGSVGElement>('.brand-progress') ?? null;
  const progressRing = header?.querySelector<SVGRectElement>('.brand-progress-ring') ?? null;

  const sizeProgressRing = () => {
    if (!brandCapsule || !progressSvg || !progressRing) return;
    const w = brandCapsule.offsetWidth;
    const h = brandCapsule.offsetHeight;
    if (w <= 0 || h <= 0) return;
    progressSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    progressRing.setAttribute('width', String(Math.max(0, w - 3)));
    progressRing.setAttribute('height', String(Math.max(0, h - 3)));
    progressRing.setAttribute('rx', String(Math.max(0, (h - 3) / 2)));
  };

  const updateProgressRing = () => {
    if (!progressRing) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    progressRing.style.strokeDashoffset = String(100 - p * 100);
  };

  if (header) {
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
      updateProgressRing();
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    sizeProgressRing();
    update();
    // Track the pill box through the collapse transition and viewport changes
    if (brandCapsule && 'ResizeObserver' in window) {
      new ResizeObserver(() => sizeProgressRing()).observe(brandCapsule);
    } else {
      window.addEventListener('resize', sizeProgressRing, { passive: true });
    }
  }

  // Mobile menu toggle (preserved)
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('mobile-nav');
  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      drawer.setAttribute('aria-hidden', String(isOpen));
      drawer.classList.toggle('is-open', !isOpen);
    });

    // Close on link click
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.classList.remove('is-open');
      });
    });
  }
</script>
