---
// landing/src/components/Nav.astro
// Floating glassmorphic navigation with quiet hardware status and responsive mobile drawer
---

<header id="nav" class="nav-root">
  <!-- Subtle scroll progress indicator -->
  <div class="scroll-track" aria-hidden="true">
    <div class="scroll-bar" id="scroll-progress-bar"></div>
  </div>

  <div class="container nav-container">
    <!-- Brand -->
    <div class="nav-brand-group">
      <a href="#hero" class="nav-brand" aria-label="Home Cloud — Home">
        <div class="nav-brand-icon">
          <img
            src="/favicon.svg"
            alt="Home Cloud"
            width="32"
            height="32"
            class="nav-brand-favicon"
            loading="eager"
            decoding="async"
          />
          <span class="brand-glow"></span>
        </div>
        <span class="nav-brand-name">Home Cloud</span>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links" aria-label="Main Navigation">
      <a href="#showcase" class="nav-link">Interactive Preview</a>
      <a href="#craft" class="nav-link">Hardware Craft</a>
      <a href="#features" class="nav-link">Features</a>
      <a href="#setup" class="nav-link">Setup</a>
    </nav>

    <!-- Actions -->
    <div class="nav-actions">
      <a
        href="https://github.com/Cypher-0071/Home_Cloud"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-gh-link"
        aria-label="View Home Cloud on GitHub"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
        <span class="gh-text">GitHub</span>
      </a>

      <a href="#setup" class="nav-cta-btn">
        <span>Install</span>
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-content">
      <nav class="mobile-nav-links">
        <a href="#showcase" class="mobile-link">Interactive Preview</a>
        <a href="#craft" class="mobile-link">Hardware Craft</a>
        <a href="#features" class="mobile-link">Features</a>
        <a href="#setup" class="mobile-link">Setup</a>
      </nav>
      <div class="mobile-actions">
        <a
          href="https://github.com/Cypher-0071/Home_Cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-gh-btn"
        >
          View on GitHub
        </a>
        <a href="#setup" class="mobile-install-btn">
          Install Home Cloud
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-root {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(9, 10, 13, 0.78);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: background-color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }

  .scroll-track {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: transparent;
    pointer-events: none;
  }

  .scroll-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--signal), var(--signal-bright));
    box-shadow: 0 0 8px var(--signal-glow);
    transition: width 60ms linear;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: var(--space-4);
  }

  .nav-brand-group {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
  }

  .nav-brand-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 7px;
    flex-shrink: 0;
  }

  .nav-brand-favicon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    display: block;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 2px 6px rgba(0, 0, 0, 0.4);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .brand-glow {
    position: absolute;
    inset: -2px;
    border-radius: 9px;
    box-shadow: 0 0 16px var(--signal-glow);
    opacity: 0.45;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .nav-brand:hover .nav-brand-favicon {
    transform: scale(1.04);
    box-shadow: 0 0 0 1px rgba(255, 92, 40, 0.4), 0 4px 12px rgba(0, 0, 0, 0.6);
  }

  .nav-brand:hover .brand-glow {
    opacity: 0.85;
  }

  .nav-brand-name {
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }


  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-out);
    padding: var(--space-1) 0;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-gh-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    transition: all var(--dur-fast) var(--ease-out);
  }

  .nav-gh-link:hover {
    background: rgba(255, 255, 255, 0.07);
    color: var(--text-primary);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .nav-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--text-primary);
    color: #0b0d12;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: all var(--dur-fast) var(--ease-out);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .nav-cta-btn:hover {
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.2), inset 0 1px 0 #ffffff;
    transform: translateY(-1px);
  }

  .nav-cta-btn:active {
    transform: scale(0.97);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
  }

  .toggle-bar {
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast);
  }

  .nav-toggle[aria-expanded="true"] .toggle-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .toggle-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-drawer {
    display: none;
    background: rgba(13, 15, 20, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--space-5) var(--gutter);
  }

  .mobile-drawer.is-open {
    display: block;
    animation: slideDown 220ms var(--ease-out);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .mobile-link {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-primary);
    padding: var(--space-2) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-gh-btn,
  .mobile-install-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .mobile-gh-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-primary);
  }

  .mobile-install-btn {
    background: var(--text-primary);
    color: #0b0d12;
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-gh-link {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Scroll progress handler
  const bar = document.getElementById('scroll-progress-bar');
  if (bar) {
    window.addEventListener('scroll', () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      const progress = h > 0 ? (window.scrollY / h) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }, { passive: true });
  }

  // Mobile menu toggle
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('mobile-nav');
  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      drawer.setAttribute('aria-hidden', String(isOpen));
      drawer.classList.toggle('is-open', !isOpen);
    });

    // Close on link click
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.classList.remove('is-open');
      });
    });
  }
</script>
