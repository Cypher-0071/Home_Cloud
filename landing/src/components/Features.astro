---
// landing/src/components/Features.astro
// Feature Highlights: 4 focused, beautifully crafted Bento cards with tactile micro-interactions
// (Host Terminal, Container Engine, Sovereign Storage, Zero-Trust Tunnel)
---

<section id="features" class="features-section">
  <div class="container features-container">
    <div class="features-header reveal">
      <div class="eyebrow-pill">
        <span class="pill-dot"></span>
        <span>Capabilities</span>
      </div>
      <h2 class="features-title">
        Engineered for real self-hosting.<br />
        <span class="font-serif-italic">Built without the clutter.</span>
      </h2>
      <p class="features-desc">
        Four primary subsystems working together through a lightweight background daemon.
        No bloated hypervisor layers or multi-gigabyte management frameworks.
      </p>
    </div>

    <div class="features-bento-grid">
      <!-- Feature Card 1: Web Terminal -->
      <div class="bento-card reveal">
        <div class="card-glow" aria-hidden="true"></div>
        <div class="card-icon-bar">
          <div class="feature-icon orange">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <span class="card-tag">Host Shell</span>
        </div>

        <h3 class="card-title">Real PTY Terminal in Any Browser</h3>
        <p class="card-desc">
          Full xterm-compatible terminal streaming over binary WebSockets. Run vim, htop, zsh,
          and tmux with full 256-color support and UTF-8 glyphs. Your session stays alive
          even if your laptop lid closes.
        </p>

        <!-- Micro-Interactive Visual Preview -->
        <div class="card-micro-preview terminal-preview">
          <div class="preview-chrome">
            <span class="p-dot"></span>
            <span class="p-dot"></span>
            <span class="p-dot"></span>
            <span class="p-title">pts/3 · zsh</span>
          </div>
          <div class="preview-body mono">
            <div class="code-line"><span class="c-prompt">$</span> <span class="c-cmd">systemctl status homecloud</span></div>
            <div class="code-line c-ok">● homecloud.service - active (running)</div>
            <div class="code-line c-dim">  Memory: 42.1M · Tasks: 12 · CPU: 0.1%</div>
          </div>
        </div>
      </div>

      <!-- Feature Card 2: Docker Containers -->
      <div class="bento-card reveal">
        <div class="card-glow" aria-hidden="true"></div>
        <div class="card-icon-bar">
          <div class="feature-icon blue">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <span class="card-tag">Containers</span>
        </div>

        <h3 class="card-title">Docker Orchestration Without Overhead</h3>
        <p class="card-desc">
          Spin up community services with zero configuration friction. Inspect live stdout logs,
          restart crashed containers, pull image updates, and monitor memory caps without SSHing
          into the box.
        </p>

        <!-- Micro-Interactive Visual Preview -->
        <div class="card-micro-preview docker-preview">
          <div class="docker-mini-row">
            <span class="mini-status-led"></span>
            <span class="mini-name">nextcloud</span>
            <span class="mini-metric">284 MB</span>
            <span class="mini-badge ok">Healthy</span>
          </div>
          <div class="docker-mini-row">
            <span class="mini-status-led"></span>
            <span class="mini-name">plex-server</span>
            <span class="mini-metric">512 MB</span>
            <span class="mini-badge ok">Healthy</span>
          </div>
          <div class="docker-mini-row">
            <span class="mini-status-led"></span>
            <span class="mini-name">postgres-16</span>
            <span class="mini-metric">146 MB</span>
            <span class="mini-badge ok">Healthy</span>
          </div>
        </div>
      </div>

      <!-- Feature Card 3: Storage & Files -->
      <div class="bento-card reveal">
        <div class="card-glow" aria-hidden="true"></div>
        <div class="card-icon-bar">
          <div class="feature-icon purple">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <span class="card-tag">Filesystem</span>
        </div>

        <h3 class="card-title">Native Ext4 & ZFS Storage Workspace</h3>
        <p class="card-desc">
          Browse, upload, download, and manage files directly on your host disks.
          Drag and drop large video files or folder trees with chunked resume support.
          Direct filesystem calls, zero virtualization tax.
        </p>

        <!-- Micro-Interactive Visual Preview -->
        <div class="card-micro-preview file-preview">
          <div class="file-item">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="#60a5fa"><path d="M1 3.5A1.5 1.5 0 0 1 2.5 2h2.764c.958 0 1.76.56 2.311 1.184l.73.816H13.5A1.5 1.5 0 0 1 15 5.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 12.5v-9z"/></svg>
            <span class="file-name">Media / 4K / Home-Video.mkv</span>
            <span class="file-size">14.8 GB</span>
          </div>
          <div class="file-item">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="#a78bfa"><path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2z"/></svg>
            <span class="file-name">docker-compose.production.yml</span>
            <span class="file-size">4.2 KB</span>
          </div>
        </div>
      </div>

      <!-- Feature Card 4: Zero Trust Tunnel -->
      <div class="bento-card reveal">
        <div class="card-glow" aria-hidden="true"></div>
        <div class="card-icon-bar">
          <div class="feature-icon green">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <span class="card-tag">Zero-Trust</span>
        </div>

        <h3 class="card-title">Encrypted Cloudflare Tunnel</h3>
        <p class="card-desc">
          Automated edge tunnel routing that completely obsoletes DDNS, UPnP, and risky router port forwarding.
          Reach your dashboard securely from any coffee shop, airport Wi-Fi, or cellular network with instant TLS.
        </p>

        <!-- Micro-Interactive Visual Preview -->
        <div class="card-micro-preview tunnel-preview">
          <div class="tunnel-status-row">
            <span class="tunnel-badge-dot"></span>
            <span class="tunnel-domain mono">cloud.yourname.me</span>
            <span class="tunnel-tls">TLS 1.3 · QUIC</span>
          </div>
          <div class="tunnel-meta-row">
            <span>External Ports Open: <strong>0</strong></span>
            <span>Edge Routing: <strong>330+ Cities</strong></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features-section {
    position: relative;
    padding-block: clamp(4rem, 6vw, 7.5rem);
  }

  .features-container {
    max-width: 1200px;
  }

  .features-header {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: var(--space-7);
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(255, 92, 40, 0.08);
    border: 1px solid rgba(255, 92, 40, 0.2);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--signal-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-3);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 6px var(--signal-glow);
  }

  .features-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .features-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .features-bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.2rem, 2vw, 1.8rem);
  }

  .bento-card {
    position: relative;
    background: #0d1017;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all var(--dur) var(--ease-out);
  }

  .bento-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.7);
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    opacity: 0.5;
  }

  .card-icon-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .feature-icon.orange {
    color: var(--signal-text);
    background: rgba(255, 92, 40, 0.08);
    border-color: rgba(255, 92, 40, 0.2);
  }

  .feature-icon.blue {
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.08);
    border-color: rgba(96, 165, 250, 0.2);
  }

  .feature-icon.purple {
    color: #c084fc;
    background: rgba(192, 132, 252, 0.08);
    border-color: rgba(192, 132, 252, 0.2);
  }

  .feature-icon.green {
    color: var(--ok-night);
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.2);
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-tertiary);
  }

  .card-title {
    font-size: 1.22rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
    letter-spacing: -0.015em;
  }

  .card-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
  }

  /* Micro previews */
  .card-micro-preview {
    margin-top: auto;
    background: #080a0e;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 12px;
    overflow: hidden;
  }

  /* Terminal Micro Preview */
  .preview-chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .p-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .p-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
  }

  .preview-body {
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .c-prompt { color: var(--signal); }
  .c-cmd { color: #ffffff; }
  .c-ok { color: var(--ok-night); }
  .c-dim { color: var(--text-tertiary); }

  /* Docker Mini Rows */
  .docker-mini-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    margin-bottom: 4px;
  }

  .docker-mini-row:last-child {
    margin-bottom: 0;
  }

  .mini-status-led {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 5px var(--ok-glow);
  }

  .mini-name { color: var(--text-primary); font-weight: 500; }
  .mini-metric { color: var(--text-tertiary); }
  .mini-badge {
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.68rem;
  }
  .mini-badge.ok {
    background: rgba(16, 185, 129, 0.12);
    color: var(--ok-night);
  }

  /* File item preview */
  .file-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .file-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  .file-size {
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    font-size: 0.72rem;
  }

  /* Tunnel preview */
  .tunnel-status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .tunnel-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 6px var(--signal-glow);
  }

  .tunnel-domain {
    font-size: 0.8rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .tunnel-tls {
    font-size: 0.7rem;
    color: var(--ok-night);
    font-family: var(--font-mono);
  }

  .tunnel-meta-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.74rem;
    color: var(--text-tertiary);
  }

  .tunnel-meta-row strong {
    color: var(--text-primary);
  }

  @media (max-width: 860px) {
    .features-bento-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
