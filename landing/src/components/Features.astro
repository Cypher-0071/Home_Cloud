---
// Features.astro — §02 Features ("Paper & Signal")
---

<section class="section features-section" id="features">
  <div class="container">
    <!-- Section Header -->
    <header class="features-header reveal">
      <span class="eyebrow">§ 02 — Inside the box</span>
      <h2 class="display features-title">Four instruments, <em>one daemon.</em></h2>
      <p class="lede features-lede">
        Everything lives in a single Node.js process (Express 5 + <code>ws</code>) on port 3000, supervised by systemd. No background sprawl, no container nesting penalties, no hijacked operating system. A single process handles telemetry, storage, shells, and containers.
      </p>
    </header>

    <!-- Datasheet 2x2 Grid Frame -->
    <div class="datasheet-wrap reveal" style="--reveal-delay: 80ms">
      <span class="crop-mark top-left" aria-hidden="true">+</span>
      <span class="crop-mark top-right" aria-hidden="true">+</span>
      <span class="crop-mark bottom-left" aria-hidden="true">+</span>
      <span class="crop-mark bottom-right" aria-hidden="true">+</span>

      <div class="datasheet-grid">
        <!-- Instrument 01: Activity Monitor -->
        <article class="sheet-cell cell-telemetry" data-instrument="01">
          <div class="cell-head">
            <div class="cell-meta">
              <span class="cell-idx">01</span>
              <span class="cell-tag">TELEMETRY // SSE</span>
            </div>
            <div class="cell-indicator">
              <span class="status-pulse" aria-hidden="true"></span>
              <span class="indicator-label">LIVE STREAM</span>
            </div>
          </div>

          <h3 class="cell-name">Activity Monitor</h3>
          <p class="cell-desc">
            Live CPU, memory, disk, and network I/O streamed over Server-Sent Events every 2 seconds. Sub-second kernel telemetry without polling overhead or daemon lag.
          </p>

          <!-- Micro-visual 01: Telemetry Dashboard -->
          <div class="micro-visual mv-telemetry" aria-hidden="true">
            <div class="mv-meta-bar">
              <span class="mv-mono-id">PROC // TELEMETRY_STREAM</span>
              <span class="mv-mono-val">CADENCE: 2.0s</span>
            </div>

            <!-- CPU Channel -->
            <div class="mv-channel">
              <div class="mv-channel-head">
                <span class="mv-channel-label">CPU LOAD</span>
                <span class="mv-channel-stat metric-cpu">38.4%</span>
              </div>
              <div class="mv-spark-box">
                <svg class="telemetry-sparkline" viewBox="0 0 240 32" preserveAspectRatio="none">
                  <path
                    class="sparkline-grid-line"
                    d="M 0 8 L 240 8 M 0 16 L 240 16 M 0 24 L 240 24"
                  />
                  <path
                    class="sparkline-path"
                    d="M 0,22 Q 20,24 40,16 T 80,18 T 120,8 T 160,20 T 200,10 T 240,14"
                  />
                  <circle class="sparkline-dot" cx="240" cy="14" r="3" />
                </svg>
              </div>
              <div class="mv-meter-blocks">
                <span class="meter-block is-active"></span>
                <span class="meter-block is-active"></span>
                <span class="meter-block is-active"></span>
                <span class="meter-block is-active"></span>
                <span class="meter-block is-active"></span>
                <span class="meter-block is-active is-signal"></span>
                <span class="meter-block"></span>
                <span class="meter-block"></span>
                <span class="meter-block"></span>
                <span class="meter-block"></span>
                <span class="meter-block"></span>
                <span class="meter-block"></span>
              </div>
            </div>

            <!-- Memory & Network mini dual row -->
            <div class="mv-dual-row">
              <div class="mv-mini-block">
                <div class="mv-channel-head">
                  <span class="mv-channel-label">RAM</span>
                  <span class="mv-channel-stat">4.2 / 16 GB</span>
                </div>
                <div class="mv-seg-bar">
                  <div class="seg-fill seg-used" style="width: 26%"></div>
                  <div class="seg-fill seg-cache" style="width: 18%"></div>
                </div>
              </div>
              <div class="mv-mini-block">
                <div class="mv-channel-head">
                  <span class="mv-channel-label">NET ENP3S0</span>
                  <span class="mv-channel-stat">↑ 42K · ↓ 1.4M</span>
                </div>
                <div class="mv-net-activity">
                  <span class="net-pulse pulse-tx"></span>
                  <span class="net-pulse pulse-rx"></span>
                  <span class="net-wire"></span>
                </div>
              </div>
            </div>
          </div>

          <div class="cell-foot">
            <code>SSE · 2s interval · systeminformation</code>
          </div>
        </article>

        <!-- Instrument 02: File Explorer -->
        <article class="sheet-cell cell-files" data-instrument="02">
          <div class="cell-head">
            <div class="cell-meta">
              <span class="cell-idx">02</span>
              <span class="cell-tag">STORAGE // FS</span>
            </div>
            <div class="cell-indicator">
              <span class="status-pulse ok" aria-hidden="true"></span>
              <span class="indicator-label">JAILED MOUNT</span>
            </div>
          </div>

          <h3 class="cell-name">File Explorer</h3>
          <p class="cell-desc">
            Browse, upload, download, rename, and delete files with desktop speed. Strictly jailed to your home directory (<code>$BASE_DIR</code>) with zero symlink escapes or path traversal.
          </p>

          <!-- Micro-visual 02: Filesystem Tree -->
          <div class="micro-visual mv-files" aria-hidden="true">
            <div class="mv-crumb-bar">
              <div class="mv-crumb-path">
                <span class="crumb-root">$BASE_DIR</span>
                <span class="crumb-sep">/</span>
                <span class="crumb-node">media</span>
                <span class="crumb-sep">/</span>
                <span class="crumb-node is-active">compose</span>
              </div>
              <span class="mv-crumb-badge">RW ACCESS</span>
            </div>

            <div class="mv-file-list">
              <div class="mv-file-row">
                <span class="file-icon icon-dir">📁</span>
                <span class="file-name">jellyfin/</span>
                <span class="file-meta">drwxr-xr-x</span>
                <span class="file-size">4 KB</span>
              </div>
              <div class="mv-file-row is-selected">
                <span class="file-icon icon-yaml">📄</span>
                <span class="file-name">docker-compose.yml</span>
                <span class="file-meta">-rw-r--r--</span>
                <span class="file-badge">COMPOSE</span>
                <span class="file-size">2.4 KB</span>
              </div>
              <div class="mv-file-row">
                <span class="file-icon icon-lock">🔒</span>
                <span class="file-name">.env.secrets</span>
                <span class="file-meta">-rw-------</span>
                <span class="file-size">1.1 KB</span>
              </div>
              <div class="mv-file-row">
                <span class="file-icon icon-pkg">📦</span>
                <span class="file-name">backup-weekly.tar.gz</span>
                <span class="file-meta">-rw-r--r--</span>
                <span class="file-size">412 MB</span>
              </div>
            </div>

            <div class="mv-file-action-strip">
              <span class="action-pill">HTTP MULTIPART</span>
              <span class="action-pill">JAILED ROOT</span>
              <span class="action-pill">STREAMING IO</span>
            </div>
          </div>

          <div class="cell-foot">
            <code>jailed to $BASE_DIR · streaming multipart · posix</code>
          </div>
        </article>

        <!-- Instrument 03: Terminal -->
        <article class="sheet-cell cell-terminal" data-instrument="03">
          <div class="cell-head">
            <div class="cell-meta">
              <span class="cell-idx">03</span>
              <span class="cell-tag">SHELL // PTY</span>
            </div>
            <div class="cell-indicator">
              <span class="status-pulse ok" aria-hidden="true"></span>
              <span class="indicator-label">TTY ATTACHED</span>
            </div>
          </div>

          <h3 class="cell-name">Terminal</h3>
          <p class="cell-desc">
            A real host shell powered by node-pty and xterm.js over WebSocket. Interactive terminal curses (htop, nano, vim), ANSI 256 colors, and proper window resize signals.
          </p>

          <!-- Micro-visual 03: Terminal Console -->
          <div class="micro-visual mv-term" aria-hidden="true">
            <div class="mv-term-bar">
              <span class="term-pts">TTY // /dev/pts/3 · 80x24</span>
              <div class="term-swatches">
                <span class="swatch c-red"></span>
                <span class="swatch c-grn"></span>
                <span class="swatch c-yel"></span>
                <span class="swatch c-blu"></span>
                <span class="swatch c-mag"></span>
                <span class="swatch c-cyn"></span>
                <span class="swatch c-sig"></span>
              </div>
            </div>

            <div class="term-screen">
              <div class="term-line">
                <span class="term-p-user">rudra@closet</span><span class="term-p-sep">:</span><span class="term-p-path">~</span><span class="term-p-dollar">$</span>
                <span class="term-p-cmd">docker ps --format '&#123;&#123;.Names&#125;&#125;\t&#123;&#123;.Status&#125;&#125;'</span>
              </div>
              <div class="term-line term-dim">
                <span class="col-name">jellyfin</span>
                <span class="col-status">Up 6 days (healthy)</span>
              </div>
              <div class="term-line term-dim">
                <span class="col-name">immich_server</span>
                <span class="col-status">Up 6 days</span>
              </div>
              <div class="term-line">
                <span class="term-p-user">rudra@closet</span><span class="term-p-sep">:</span><span class="term-p-path">~</span><span class="term-p-dollar">$</span>
                <span class="term-p-active">pnpm build</span><span class="term-cursor">█</span>
              </div>
            </div>

            <div class="mv-term-footer">
              <span class="term-proto">WS // BINARY STREAM</span>
              <span class="term-state">RAW MODE: ACTIVE</span>
            </div>
          </div>

          <div class="cell-foot">
            <code>node-pty · xterm-256color · ws binary stream</code>
          </div>
        </article>

        <!-- Instrument 04: Docker Manager -->
        <article class="sheet-cell cell-docker" data-instrument="04">
          <div class="cell-head">
            <div class="cell-meta">
              <span class="cell-idx">04</span>
              <span class="cell-tag">CONTAINERS // OCI</span>
            </div>
            <div class="cell-indicator">
              <span class="status-pulse ok" aria-hidden="true"></span>
              <span class="indicator-label">ENGINE READY</span>
            </div>
          </div>

          <h3 class="cell-name">Docker Manager</h3>
          <p class="cell-desc">
            Direct container supervision, image pulls, and Compose stacks with an inline YAML editor. View live container logs, inspect resource stats, and launch in-container exec shells.
          </p>

          <!-- Micro-visual 04: Stacked Container Matrix -->
          <div class="micro-visual mv-docker" aria-hidden="true">
            <div class="mv-docker-bar">
              <span class="docker-title">CONTAINER STACKS // DOCKER ENGINE</span>
              <span class="docker-count">3 RUNNING</span>
            </div>

            <div class="mv-docker-rows">
              <div class="mv-dock-row">
                <div class="dock-left">
                  <span class="dock-dot"></span>
                  <span class="dock-name">jellyfin</span>
                  <span class="dock-tag">latest</span>
                </div>
                <div class="dock-right">
                  <span class="dock-port">8096/tcp</span>
                  <span class="dock-ingress">jellyfin.you.dev ↗</span>
                </div>
              </div>

              <div class="mv-dock-row">
                <div class="dock-left">
                  <span class="dock-dot"></span>
                  <span class="dock-name">immich</span>
                  <span class="dock-tag">v1.105</span>
                </div>
                <div class="dock-right">
                  <span class="dock-port">2283/tcp</span>
                  <span class="dock-ingress">immich.you.dev ↗</span>
                </div>
              </div>

              <div class="mv-dock-row">
                <div class="dock-left">
                  <span class="dock-dot"></span>
                  <span class="dock-name">vaultwarden</span>
                  <span class="dock-tag">alpine</span>
                </div>
                <div class="dock-right">
                  <span class="dock-port">8080/tcp</span>
                  <span class="dock-ingress">vault.you.dev ↗</span>
                </div>
              </div>
            </div>

            <div class="mv-dock-stats">
              <span class="dock-stat-item">SOCKET: /var/run/docker.sock</span>
              <span class="dock-stat-item">EXEC CONSOLE: READY</span>
            </div>
          </div>

          <div class="cell-foot">
            <code>dockerode · compose CLI · unix socket daemon</code>
          </div>
        </article>
      </div>
    </div>

    <!-- Also in the Box Section -->
    <div class="also-section reveal" style="--reveal-delay: 140ms">
      <div class="also-head">
        <span class="eyebrow">§ 02.1 — Included Subsystems</span>
        <h3 class="display also-title">Also in the <em>box.</em></h3>
      </div>

      <div class="also-table">
        <!-- Row 1: Auto-wired subdomains -->
        <div class="also-row">
          <div class="also-col-label">
            <span class="mono-idx">01</span>
            <span class="mono-cat">ROUTING</span>
          </div>
          <div class="also-col-body">
            <h4 class="also-name">Auto-wired subdomains</h4>
            <p class="also-desc">
              Expose a container and Home Cloud writes the Cloudflare ingress rule and automatically reloads the tunnel. Zero manual YAML edits, zero Cloudflare dashboard logins.
            </p>
          </div>
          <div class="also-col-demo">
            <div class="flow-pill">
              <span class="flow-cmd"><code>docker run jellyfin</code></span>
              <span class="flow-arr" aria-hidden="true">→</span>
              <span class="flow-target"><code>jellyfin.you.dev</code></span>
            </div>
          </div>
        </div>

        <!-- Row 2: Split-horizon LAN switching -->
        <div class="also-row">
          <div class="also-col-label">
            <span class="mono-idx">02</span>
            <span class="mono-cat">NETWORKING</span>
          </div>
          <div class="also-col-body">
            <h4 class="also-name">Split-horizon LAN switching</h4>
            <p class="also-desc">
              At home, the dashboard detects your local Wi-Fi or ethernet subnet and speaks directly to port 3000 over gigabit LAN for zero-latency streaming. Outside, traffic routes seamlessly via Cloudflare's edge.
            </p>
          </div>
          <div class="also-col-demo">
            <div class="lan-pill">
              <span class="lan-dot ok" aria-hidden="true"></span>
              <span class="lan-meta"><code>192.168.1.0/24 ⇄ edge.quic</code></span>
            </div>
          </div>
        </div>

        <!-- Row 3: systemd service -->
        <div class="also-row">
          <div class="also-col-label">
            <span class="mono-idx">03</span>
            <span class="mono-cat">SUPERVISION</span>
          </div>
          <div class="also-col-body">
            <h4 class="also-name">systemd service</h4>
            <p class="also-desc">
              Packaged as a native Linux service (<code>home-cloud.service</code>). Starts on boot, handles graceful SIGTERM shutdowns, logs to journald, and recovers in milliseconds on unexpected fault.
            </p>
          </div>
          <div class="also-col-demo">
            <div class="lan-pill">
              <span class="lan-dot ok" aria-hidden="true"></span>
              <span class="lan-meta"><code>systemctl status home-cloud</code></span>
            </div>
          </div>
        </div>

        <!-- Row 4: Mobile-ready -->
        <div class="also-row">
          <div class="also-col-label">
            <span class="mono-idx">04</span>
            <span class="mono-cat">VIEWPORT</span>
          </div>
          <div class="also-col-body">
            <h4 class="also-name">Mobile-ready desktop</h4>
            <p class="also-desc">
              Adaptive window manager transforms gracefully on touchscreens. Bottom drawer navigation, soft function keys, and touch-tested window multitasking down to 360px viewport widths.
            </p>
          </div>
          <div class="also-col-demo">
            <div class="lan-pill">
              <span class="lan-meta"><code>viewport ≥ 360px · soft-keys</code></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     Features Section Styles — Paper & Signal
     ========================================================================== */

  .features-section {
    background: var(--paper);
    color: var(--ink-2);
  }

  .features-header {
    margin-bottom: var(--space-8);
  }

  .features-title {
    font-size: var(--step-3);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .features-lede {
    max-width: 68ch;
  }

  /* ---- Datasheet 2x2 Grid Frame ---- */
  .datasheet-wrap {
    position: relative;
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  /* Crop marks at frame corners */
  .crop-mark {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1;
    color: var(--ink-3);
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }
  .crop-mark.top-left {
    top: -8px;
    left: -6px;
  }
  .crop-mark.top-right {
    top: -8px;
    right: -6px;
  }
  .crop-mark.bottom-left {
    bottom: -8px;
    left: -6px;
  }
  .crop-mark.bottom-right {
    bottom: -8px;
    right: -6px;
  }

  .datasheet-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  /* Grid Cells */
  .sheet-cell {
    position: relative;
    padding: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    transition: background-color var(--dur) var(--ease-out);
  }

  /* Remove outer cell borders inside 2x2 grid */
  .sheet-cell:nth-child(2n) {
    border-right: none;
  }
  .sheet-cell:nth-child(3),
  .sheet-cell:nth-child(4) {
    border-bottom: none;
  }

  .sheet-cell:hover {
    background: var(--paper-2);
  }

  /* Cell Header */
  .cell-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .cell-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cell-idx {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--signal-ink);
  }

  .cell-tag {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .cell-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .status-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 rgba(31, 122, 85, 0.4);
    animation: statusPulse 2.4s infinite;
  }
  .status-pulse.ok {
    background: var(--ok);
  }

  @keyframes statusPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(31, 122, 85, 0.4);
    }
    70% {
      box-shadow: 0 0 0 5px rgba(31, 122, 85, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(31, 122, 85, 0);
    }
  }

  .indicator-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    text-transform: uppercase;
  }

  /* Cell Titles & Body */
  .cell-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: var(--space-2);
    letter-spacing: -0.015em;
  }

  .cell-desc {
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-2);
    margin-bottom: var(--space-5);
    max-width: 50ch;
  }

  .cell-desc code {
    background: var(--paper-2);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
    font-size: 0.88em;
  }

  .cell-foot {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--rule);
  }

  .cell-foot code {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    text-transform: uppercase;
  }

  /* ==========================================================================
     Micro-visuals Styling
     ========================================================================== */

  .micro-visual {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    user-select: none;
    transition: border-color var(--dur) var(--ease-out);
  }

  .sheet-cell:hover .micro-visual {
    border-color: var(--rule-strong);
    background: var(--paper-3);
  }

  /* ---- Visual 01: Telemetry ---- */
  .mv-meta-bar {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--ink-3);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .mv-channel {
    margin-bottom: var(--space-3);
  }

  .mv-channel-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--ink-2);
    margin-bottom: 4px;
  }

  .mv-channel-stat {
    font-weight: 600;
    color: var(--ink);
  }
  .mv-channel-stat.metric-cpu {
    color: var(--signal-ink);
  }

  .mv-spark-box {
    width: 100%;
    height: 32px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 6px;
  }

  .telemetry-sparkline {
    width: 100%;
    height: 100%;
    display: block;
  }

  .sparkline-grid-line {
    stroke: var(--rule);
    stroke-width: 0.5;
    stroke-dasharray: 2 3;
    fill: none;
  }

  .sparkline-path {
    stroke: var(--signal);
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.6s var(--ease-out);
  }

  .sparkline-dot {
    fill: var(--signal);
    animation: sparkPulse 1.8s infinite;
  }

  @keyframes sparkPulse {
    0%, 100% {
      r: 2.5;
      opacity: 0.9;
    }
    50% {
      r: 4;
      opacity: 1;
    }
  }

  .mv-meter-blocks {
    display: flex;
    gap: 3px;
  }

  .meter-block {
    flex: 1;
    height: 6px;
    background: var(--rule);
    border-radius: 1px;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .meter-block.is-active {
    background: var(--ink);
  }

  .meter-block.is-active.is-signal {
    background: var(--signal);
  }

