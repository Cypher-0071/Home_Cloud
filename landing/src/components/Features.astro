<script>
  // Features section interactive telemetry & animation observer
  (() => {
    const section = document.getElementById('features');
    if (!section) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const sparkPath = section.querySelector<SVGPathElement>('.sparkline-path');
    const sparkDot = section.querySelector<SVGCircleElement>('.sparkline-dot');
    const cpuStat = section.querySelector<HTMLElement>('.metric-cpu');

    // Simulation points for CPU sparkline
    let step = 0;
    let animFrameId: number | null = null;
    let isVisible = false;

    const updateTelemetry = () => {
      if (!isVisible || document.hidden) return;

      step++;
      // Subtle sine wave variation with jitter for realistic telemetry stream
      const load = 34 + Math.sin(step * 0.4) * 8 + (Math.random() * 4 - 2);
      const clampedLoad = Math.max(20, Math.min(85, load)).toFixed(1);

      if (cpuStat) {
        cpuStat.textContent = `${clampedLoad}%`;
      }

      if (sparkPath && sparkDot) {
        const yEnd = 24 - (Number(clampedLoad) / 100) * 20;
        const yMid1 = 18 + Math.sin(step * 0.3) * 6;
        const yMid2 = 14 + Math.cos(step * 0.4) * 6;
        sparkPath.setAttribute(
          'd',
          `M 0,22 Q 20,${yMid1} 40,16 T 80,${yMid2} T 120,${18 + Math.sin(step) * 4} T 160,${yMid1} T 200,${yMid2} T 240,${yEnd.toFixed(1)}`
        );
        sparkDot.setAttribute('cy', yEnd.toFixed(1));
      }
    };

    let intervalId: number | null = null;

    const startLoop = () => {
      if (!intervalId) {
        intervalId = window.setInterval(updateTelemetry, 1600);
      }
    };

    const stopLoop = () => {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    };

    // IntersectionObserver to only animate when in view
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible && !document.hidden) {
            startLoop();
          } else {
            stopLoop();
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(section);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopLoop();
      } else if (isVisible) {
        startLoop();
      }
    });
  })();
</script>
